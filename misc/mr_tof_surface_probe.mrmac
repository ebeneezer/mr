$MACRO TofSurfaceProbe FROM EDIT;
DEF_INT(Fail);
DEF_STR(Result);

Fail := 0;
Result := 'PASS tof-surface';

GOTO_LINE(4);
GOTO_COL(9);
TOF;
IF (C_LINE = 1) AND (C_COL = 1) THEN
ELSE
    Fail := Fail + 1;
    IF Fail = 1 THEN
        Result := 'FAIL tof-plain mismatch';
    END;
END;

GOTO_LINE(2);
GOTO_COL(3);
COL_BLOCK_BEGIN;
GOTO_LINE(2);
GOTO_COL(8);
BLOCK_END;
TOF;
IF (C_LINE = 1) AND (C_COL = 1) THEN
ELSE
    Fail := Fail + 1;
    IF Fail = 1 THEN
        Result := 'FAIL tof-visible-block mismatch';
    END;
END;

BLOCK_OFF;
GOTO_LINE(1);
GOTO_COL(1);
TEXT(Result);
CR;
SAVE_FILE;
QUIT(0);
END_MACRO;
