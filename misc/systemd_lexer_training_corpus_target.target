# systemd_lexer_training_corpus_target.target
# Synthetic systemd/unit-file lexer-training corpus.
# It is intentionally not meant to be installed or started.
# Covers sections, assignments, comments, specifiers, escaping, lists, booleans, sizes and times.

[Unit]
Description=Lexer Training Target
Documentation=man:systemd.target(5)
Requires=network-online.target
Wants=systemd_lexer_training_corpus_service.service systemd_lexer_training_corpus_timer.timer
Conflicts=rescue.target
Before=multi-user.target
After=basic.target
AllowIsolate=yes
StopWhenUnneeded=no

# Common lexer-stress comments and escaped values
# comment with = ; %i %n ${ENV} $MAINPID "quotes" 'single quotes' \ backslash
X-LexerTraining-Key=literal=value=with=equals
X-LexerTraining-Percent=%% %n %N %i %I %p %P %f %u %U %h %H %m %b
X-LexerTraining-Spaces=alpha beta gamma
X-LexerTraining-Quoted="quoted value with spaces"
X-LexerTraining-Backslash=one\ two\ three
X-LexerTraining-Semicolon=a;b;c
X-LexerTraining-URL=https://example.invalid/path?a=1&b=two

[Install]
WantedBy=multi-user.target
Alias=lexer-training.target

# Common lexer-stress comments and escaped values
# comment with = ; %i %n ${ENV} $MAINPID "quotes" 'single quotes' \ backslash
X-LexerTraining-Key=literal=value=with=equals
X-LexerTraining-Percent=%% %n %N %i %I %p %P %f %u %U %h %H %m %b
X-LexerTraining-Spaces=alpha beta gamma
X-LexerTraining-Quoted="quoted value with spaces"
X-LexerTraining-Backslash=one\ two\ three
X-LexerTraining-Semicolon=a;b;c
X-LexerTraining-URL=https://example.invalid/path?a=1&b=two

# generated target block 001
[X-LexerTraining]
BlockIndex=1
BlockName=Generated001
SpecifierMix=%% %n %N %i %I %p %P %f %u %U %h %H %m
QuotedValue="block 001 with spaces and = signs"
EscapedValue=alpha\ beta\ gamma\ 001
BooleanValues=yes no true false on off 1 0
TimeValues=1s 1min 1h 1day
SizeValues=1K 1M 1G
ListValue=one two three block-001
EnvironmentLike=NAME=value OTHER="two words" DOLLAR=$$literal
PathLike=/var/lib/lexer-training/target/001
GlobLike=/etc/lexer-training.d/*-001.conf
URLLike=https://example.invalid/target/001?a=1&b=two
[Unit]
Wants=generated-001.service generated-001.timer
After=generated-001.service
Conflicts=generated-conflict-001.target

