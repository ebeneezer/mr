EscapedValue=alpha\ beta\ gamma\ 002
BooleanValues=yes no true false on off 1 0
TimeValues=2s 2min 2h 2day
SizeValues=2K 2M 2G
ListValue=one two three block-002
EnvironmentLike=NAME=value OTHER="two words" DOLLAR=$$literal
PathLike=/var/lib/lexer-training/device/002
