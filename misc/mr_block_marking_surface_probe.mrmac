BLOCK_OFF;
GOTO_LINE(1);
GOTO_COL(1);
BLOCK_BEGIN;
GOTO_LINE(4);
GOTO_COL(1);
BLOCK_END;
GOTO_LINE(1);
GOTO_COL(1);
STR_BLOCK_BEGIN;
GOTO_LINE(1);
GOTO_COL(6);
BLOCK_END;
IF (BLOCK_STAT = 3) AND (MARKING = 0) AND (BLOCK_LINE1 = 1) AND (BLOCK_LINE2 = 1) AND (BLOCK_COL1 = 1) AND (BLOCK_COL2 = 6) THEN
