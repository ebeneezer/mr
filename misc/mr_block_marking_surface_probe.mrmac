$MACRO BlockMarkingSurfaceProbe FROM EDIT;
DEF_INT(Fail);
DEF_STR(Result);

Fail := 0;
Result := 'PASS block-marking-surface';

BLOCK_OFF;
GOTO_LINE(3);
GOTO_COL(4);
BLOCK_BEGIN;
BLOCK_END;
IF (BLOCK_STAT = 1) AND (MARKING = 0) AND (BLOCK_LINE1 = 3) AND (BLOCK_LINE2 = 3) THEN
ELSE
