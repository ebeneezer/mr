IF (BLOCK_STAT = 2) AND (MARKING = 0) AND (BLOCK_LINE1 = 2) AND (BLOCK_LINE2 = 2) AND (BLOCK_COL1 = 3) AND (BLOCK_COL2 = 8) THEN
ELSE
    Fail := Fail + 1;
    IF Fail = 1 THEN
        Result := 'FAIL column-empty-line mismatch';
    END;
END;

BLOCK_TOGGLE_VISIBILITY;
IF (BLOCK_STAT = 0) AND (MARKING = 0) THEN
ELSE
    Fail := Fail + 1;
    IF Fail = 1 THEN
        Result := 'FAIL column-toggle-hide mismatch';
    END;
END;
BLOCK_TOGGLE_VISIBILITY;
IF (BLOCK_STAT = 2) AND (MARKING = 0) AND (BLOCK_LINE1 = 2) AND (BLOCK_LINE2 = 2) AND (BLOCK_COL1 = 3) AND (BLOCK_COL2 = 8) THEN
ELSE
    Fail := Fail + 1;
