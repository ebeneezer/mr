{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "compilerSelection",
            "type": "pickString",
            "description": "Wählen Sie den Compiler für diesen Durchlauf:",
            "options": [
                "g++",
                "clang++"
            ],
            "default": "g++"
        },
        {
            "id": "boltRunArguments",
            "type": "promptString",
            "description": "Optionale Argumente für den profilierten MR-Lauf:",
            "default": ""
        }
    ],
    "tasks": [
        {
            "label": "Build mr (Inkrementell)",
            "type": "shell",
            "command": "make",
            "args": [
                "CXX=${input:compilerSelection}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Build mr (mit TVision Auto-Sync)",
            "type": "shell",
            "command": "make",
            "args": [
                "TVISION_AUTO_SYNC=1",
                "CXX=${input:compilerSelection}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Rebuild mr (Clean & Neu)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make clean CXX=${input:compilerSelection} && make -j16 all CXX=${input:compilerSelection}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Rebuild mr (Clean & Neu, mit TVision Auto-Sync)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make clean TVISION_AUTO_SYNC=1 CXX=${input:compilerSelection} && make -j16 all TVISION_AUTO_SYNC=1 CXX=${input:compilerSelection}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Compile Manuals",
            "type": "shell",
            "command": "make",
            "args": [
                "compile-manuals"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "BOLT: GCC Seed bauen",
            "type": "shell",
            "command": "make",
            "args": [
                "bolt-seed-gcc"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "BOLT: Clang Seed bauen",
            "type": "shell",
            "command": "make",
            "args": [
                "bolt-seed-clang"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "BOLT: Profil aufzeichnen",
            "type": "shell",
            "command": "make",
            "args": [
                "bolt-record",
                "BOLT_RUN_ARGS=${input:boltRunArguments}"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "BOLT: Binary optimieren",
            "type": "shell",
            "command": "make",
            "args": [
                "bolt-optimize"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "BOLT: Artefakte löschen",
            "type": "shell",
            "command": "make",
            "args": [
                "bolt-clean"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Make context tar archive",
            "type": "shell",
            "command": "make",
            "args": [
                "context-tar"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Make tar archives",
            "type": "shell",
            "command": "make",
            "args": [
                "tar-archives"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "MRMAC Reference im externen PDF-Viewer öffnen",
            "type": "shell",
            "command": "xdg-open",
            "args": [
                "${workspaceFolder}/documentation/manuals/mr-macro-reference.pdf"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "never",
                "clear": false
            }
        }
    ]
}
