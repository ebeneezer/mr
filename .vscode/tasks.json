{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build mr (Inkrementell)",
            "type": "shell",
            "command": "make",
            "args": [
                "CXX=clang++",
                "CC=clang"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Build mr (mit TVision Auto-Sync)",
            "type": "shell",
            "command": "make",
            "args": [
                "TVISION_AUTO_SYNC=1",
                "CXX=clang++",
                "CC=clang"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Rebuild mr (Clean & Neu)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make clean CXX=clang++ CC=clang && make -j16 all CXX=clang++ CC=clang"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Rebuild mr (Clean & Neu, mit TVision Auto-Sync)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make clean TVISION_AUTO_SYNC=1 CXX=clang++ CC=clang && make -j16 all TVISION_AUTO_SYNC=1 CXX=clang++ CC=clang"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Compile Manuals",
            "type": "shell",
            "command": "make",
            "args": [
                "compile-manuals"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Make context tar archive",
            "type": "shell",
            "command": "make",
            "args": [
                "context-tar"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "Make tar archives",
            "type": "shell",
            "command": "make",
            "args": [
                "tar-archives"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "MRMAC Reference im externen PDF-Viewer öffnen",
            "type": "shell",
            "command": "xdg-open",
            "args": [
                "${workspaceFolder}/documentation/manuals/mr-macro-reference.pdf"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "never",
                "clear": false
            }
        }
    ]
}
