$MACRO DigestifSnippets FROM EDIT;
DEF_HASH(Root, Request, Sidekick);
DEF_STR(Raw, Output, Tail, Body, Ch, NextCh, NumberText, DefaultText, FirstChoice, KeySuffix, Digits, NewLine);
DEF_INT(Format, RawLen, I, Count, CloseRel, ClosePos, BodyLen, BodyPos, ColonPos, BarPos, CommaPos, EndBarPos, ChoiceEnd, StartOffset, EndOffset, DigitDone, HasRequest, RewriteDone);

Root := GLOBAL_HASH('MACROSNIPPETS');
Request := Root['request'];
Sidekick := Root['sidekick'];
Digits := '0123456789';
Sidekick['available'] := 0;
Sidekick['text'] := '';
Sidekick['placeholderCount'] := 0;
HasRequest := EXISTS(Request, 'available');

IF HasRequest = 1 THEN
    Raw := '';
    IF EXISTS(Request, 'textEditNewText') = 1 THEN
        Raw := Request['textEditNewText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'insertText') = 1) THEN
        Raw := Request['insertText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'replacementText') = 1) THEN
        Raw := Request['replacementText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'label') = 1) THEN
        Raw := Request['label'];
    END;

    Format := 1;
    IF EXISTS(Request, 'insertTextFormat') = 1 THEN
        Format := Request['insertTextFormat'];
    END;

    RewriteDone := 0;
    IF Format = 2 THEN
        NewLine := CHAR(10);
        IF (RewriteDone = 0) AND (POS('\documentclass', Raw) = 1) THEN
            Raw := '\documentclass[${1:11pt}]{${2:article}}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\usepackage', Raw) = 1) THEN
            Raw := '\usepackage[${1:options}]{${2:package}}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{document}', Raw) = 1) THEN
            Raw := '\begin{document}' + NewLine;
            Raw := Raw + '${1:content}' + NewLine;
            Raw := Raw + '\end{document}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\section', Raw) = 1) THEN
            Raw := '\section{${1:Title}}' + NewLine;
            Raw := Raw + '${2:content}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\subsection', Raw) = 1) THEN
            Raw := '\subsection{${1:Title}}' + NewLine;
            Raw := Raw + '${2:content}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\subsubsection', Raw) = 1) THEN
            Raw := '\subsubsection{${1:Title}}' + NewLine;
            Raw := Raw + '${2:content}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\paragraph', Raw) = 1) THEN
            Raw := '\paragraph{${1:Title}} ${2:text}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{itemize}', Raw) = 1) THEN
            Raw := '\begin{itemize}' + NewLine;
            Raw := Raw + '    \item ${1:item one}' + NewLine;
            Raw := Raw + '    \item ${2:item two}' + NewLine;
            Raw := Raw + '    \item ${3:item three}' + NewLine;
            Raw := Raw + '\end{itemize}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{enumerate}', Raw) = 1) THEN
            Raw := '\begin{enumerate}' + NewLine;
            Raw := Raw + '    \item ${1:item one}' + NewLine;
            Raw := Raw + '    \item ${2:item two}' + NewLine;
            Raw := Raw + '    \item ${3:item three}' + NewLine;
            Raw := Raw + '\end{enumerate}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{description}', Raw) = 1) THEN
            Raw := '\begin{description}' + NewLine;
            Raw := Raw + '    \item[${1:term}] ${2:description}' + NewLine;
            Raw := Raw + '    \item[${3:term}] ${4:description}' + NewLine;
            Raw := Raw + '\end{description}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\item', Raw) = 1) THEN
            Raw := '\item ${1:text}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{figure}', Raw) = 1) THEN
            Raw := '\begin{figure}[${1:htbp}]' + NewLine;
            Raw := Raw + '    \centering' + NewLine;
            Raw := Raw + '    \includegraphics[width=${2:0.8\linewidth}]{${3:file}}' + NewLine;
            Raw := Raw + '    \caption{${4:caption}}' + NewLine;
            Raw := Raw + '    \label{fig:${5:label}}' + NewLine;
            Raw := Raw + '\end{figure}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{table}', Raw) = 1) THEN
            Raw := '\begin{table}[${1:htbp}]' + NewLine;
            Raw := Raw + '    \centering' + NewLine;
            Raw := Raw + '    \caption{${2:caption}}' + NewLine;
            Raw := Raw + '    \label{tab:${3:label}}' + NewLine;
            Raw := Raw + '    \begin{tabular}{${4:lcr}}' + NewLine;
            Raw := Raw + '        ${5:head 1} & ${6:head 2} & ${7:head 3} \\\\' + NewLine;
            Raw := Raw + '        ${8:cell 1} & ${9:cell 2} & ${10:cell 3} \\\\' + NewLine;
            Raw := Raw + '        ${11:cell 4} & ${12:cell 5} & ${13:cell 6}' + NewLine;
            Raw := Raw + '    \end{tabular}' + NewLine;
            Raw := Raw + '\end{table}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{tabular}', Raw) = 1) THEN
            Raw := '\begin{tabular}{${1:lcr}}' + NewLine;
            Raw := Raw + '    ${2:head 1} & ${3:head 2} & ${4:head 3} \\\\' + NewLine;
            Raw := Raw + '    ${5:cell 1} & ${6:cell 2} & ${7:cell 3} \\\\' + NewLine;
            Raw := Raw + '    ${8:cell 4} & ${9:cell 5} & ${10:cell 6}' + NewLine;
            Raw := Raw + '\end{tabular}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{equation}', Raw) = 1) THEN
            Raw := '\begin{equation}' + NewLine;
            Raw := Raw + '    ${1:E = mc^2}' + NewLine;
            Raw := Raw + '\end{equation}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\begin{align}', Raw) = 1) THEN
            Raw := '\begin{align}' + NewLine;
            Raw := Raw + '    ${1:a} &= ${2:b} \\\\' + NewLine;
            Raw := Raw + '    ${3:c} &= ${4:d}' + NewLine;
            Raw := Raw + '\end{align}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\frac', Raw) = 1) THEN
            Raw := '\frac{${1:numerator}}{${2:denominator}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\sqrt', Raw) = 1) THEN
            Raw := '\sqrt[${1:index}]{${2:radicand}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\textbf', Raw) = 1) THEN
            Raw := '\textbf{${1:text}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\emph', Raw) = 1) THEN
            Raw := '\emph{${1:text}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\cite', Raw) = 1) THEN
            Raw := '\cite{${1:key}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\ref', Raw) = 1) THEN
            Raw := '\ref{${1:label}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\label', Raw) = 1) THEN
            Raw := '\label{${1:prefix}:${2:name}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\includegraphics', Raw) = 1) THEN
            Raw := '\includegraphics[width=${1:0.8\linewidth}]{${2:file}}$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (POS('\newcommand', Raw) = 1) THEN
            Raw := '\newcommand{${1:\cmd}}[${2:1}]{${3:definition}}' + NewLine + '$0';
            RewriteDone := 1;
        END;
    END;

    Output := '';
    Count := 0;
    RawLen := LENGTH(Raw);
    I := 1;

    IF Format <> 2 THEN
        Output := Raw;
    ELSE
        WHILE I <= RawLen DO
            Ch := COPY(Raw, I, 1);
            IF Ch = '\' THEN
                IF I < RawLen THEN
                    NextCh := COPY(Raw, I + 1, 1);
                    IF (NextCh = '$') OR (NextCh = '}') OR (NextCh = '\') THEN
                        Output := Output + NextCh;
                        I := I + 2;
                    ELSE
                        Output := Output + Ch;
                        I := I + 1;
                    END;
                ELSE
                    Output := Output + Ch;
                    I := I + 1;
                END;
            ELSE
                IF Ch <> '$' THEN
                    Output := Output + Ch;
                    I := I + 1;
                ELSE
                    IF I >= RawLen THEN
                        Output := Output + Ch;
                        I := I + 1;
                    ELSE
                        NextCh := COPY(Raw, I + 1, 1);
                        IF POS(NextCh, Digits) > 0 THEN
                            Count := Count + 1;
                            KeySuffix := STR(Count);
                            Sidekick['placeholderStart' + KeySuffix] := LENGTH(Output);
                            Sidekick['placeholderEnd' + KeySuffix] := LENGTH(Output);
                            I := I + 1;
                            WHILE (I <= RawLen) AND (POS(COPY(Raw, I, 1), Digits) > 0) DO
                                I := I + 1;
                            END;
                        ELSE
                            IF NextCh <> '{' THEN
                                Output := Output + Ch;
                                I := I + 1;
                            ELSE
                                Tail := COPY(Raw, I + 2, RawLen);
                                CloseRel := POS('}', Tail);
                                IF CloseRel = 0 THEN
                                    Output := Output + Ch;
                                    I := I + 1;
                                ELSE
                                    ClosePos := I + 1 + CloseRel;
                                    Body := COPY(Raw, I + 2, ClosePos - I - 2);
                                    BodyLen := LENGTH(Body);
                                    BodyPos := 1;
                                    NumberText := '';
                                    WHILE (BodyPos <= BodyLen) AND (POS(COPY(Body, BodyPos, 1), Digits) > 0) DO
                                        NumberText := NumberText + COPY(Body, BodyPos, 1);
                                        BodyPos := BodyPos + 1;
                                    END;
                                    DefaultText := '';
                                    DigitDone := 0;
                                    IF LENGTH(NumberText) > 0 THEN
                                        IF (BodyPos <= BodyLen) AND (COPY(Body, BodyPos, 1) = ':') THEN
                                            DefaultText := COPY(Body, BodyPos + 1, BodyLen);
                                            DigitDone := 1;
                                        END;
                                        IF (DigitDone = 0) AND (BodyPos <= BodyLen) AND (COPY(Body, BodyPos, 1) = '|') THEN
                                            FirstChoice := COPY(Body, BodyPos + 1, BodyLen);
                                            CommaPos := POS(',', FirstChoice);
                                            EndBarPos := POS('|', FirstChoice);
                                            ChoiceEnd := LENGTH(FirstChoice) + 1;
                                            IF (CommaPos > 0) AND (CommaPos < ChoiceEnd) THEN
                                                ChoiceEnd := CommaPos;
                                            END;
                                            IF (EndBarPos > 0) AND (EndBarPos < ChoiceEnd) THEN
                                                ChoiceEnd := EndBarPos;
                                            END;
                                            DefaultText := COPY(FirstChoice, 1, ChoiceEnd - 1);
                                            DigitDone := 1;
                                        END;
                                        IF DigitDone = 0 THEN
                                            DefaultText := '';
                                        END;
                                    ELSE
                                        DefaultText := Body;
                                    END;
                                    StartOffset := LENGTH(Output);
                                    Output := Output + DefaultText;
                                    EndOffset := LENGTH(Output);
                                    Count := Count + 1;
                                    KeySuffix := STR(Count);
                                    Sidekick['placeholderStart' + KeySuffix] := StartOffset;
                                    Sidekick['placeholderEnd' + KeySuffix] := EndOffset;
                                    I := ClosePos + 1;
                                END;
                            END;
                        END;
                    END;
                END;
            END;
        END;
    END;

    Sidekick['available'] := 1;
    Sidekick['text'] := Output;
    Sidekick['placeholderCount'] := Count;
END;

END_MACRO;
