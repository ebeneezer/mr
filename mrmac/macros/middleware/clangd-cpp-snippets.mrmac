$MACRO ClangdCppSnippets FROM EDIT;
DEF_HASH(Root, Request, Sidekick);
DEF_STR(Raw, Output, Tail, Body, Ch, NextCh, NumberText, DefaultText, FirstChoice, KeySuffix, Digits, NewLine);
DEF_INT(Format, RawLen, I, Count, CloseRel, ClosePos, BodyLen, BodyPos, ColonPos, BarPos, CommaPos, EndBarPos, ChoiceEnd, StartOffset, EndOffset, DigitDone, HasRequest, RewriteDone);

Root := GLOBAL_HASH('MACROSNIPPETS');
Request := Root['request'];
Sidekick := Root['sidekick'];
Digits := '0123456789';
Sidekick['available'] := 0;
Sidekick['text'] := '';
Sidekick['placeholderCount'] := 0;
HasRequest := EXISTS(Request, 'available');

IF HasRequest = 1 THEN
    Raw := '';
    IF EXISTS(Request, 'textEditNewText') = 1 THEN
        Raw := Request['textEditNewText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'insertText') = 1) THEN
        Raw := Request['insertText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'replacementText') = 1) THEN
        Raw := Request['replacementText'];
    END;
    IF (LENGTH(Raw) = 0) AND (EXISTS(Request, 'label') = 1) THEN
        Raw := Request['label'];
    END;

    Format := 1;
    IF EXISTS(Request, 'insertTextFormat') = 1 THEN
        Format := Request['insertTextFormat'];
    END;

    RewriteDone := 0;
    IF Format = 2 THEN
        NewLine := CHAR(10);
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 5) = 'for (') AND (POS('range-declaration', Raw) > 0) THEN
            Raw := 'for (${1:const auto &item} : ${2:items}) {' + NewLine;
            Raw := Raw + '    $0' + NewLine;
            Raw := Raw + '}';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 5) = 'for (') AND (POS('init-statement', Raw) > 0) THEN
            Raw := 'for (${1:int i = 0}; ${2:i < count}; ${3:++i}) {' + NewLine;
            Raw := Raw + '    $0' + NewLine;
            Raw := Raw + '}';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 7) = 'while (') THEN
            Raw := 'while (${1:condition}) {' + NewLine;
            Raw := Raw + '    $0' + NewLine;
            Raw := Raw + '}';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 4) = 'if (') THEN
            Raw := 'if (${1:condition}) {' + NewLine;
            Raw := Raw + '    $0' + NewLine;
            Raw := Raw + '}';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 8) = 'switch (') THEN
            Raw := 'switch (${1:expression}) {' + NewLine;
            Raw := Raw + 'case ${2:value1}:' + NewLine;
            Raw := Raw + '    ${3:statement1}' + NewLine;
            Raw := Raw + '    break;' + NewLine;
            Raw := Raw + 'case ${4:value2}:' + NewLine;
            Raw := Raw + '    ${5:statement2}' + NewLine;
            Raw := Raw + '    break;' + NewLine;
            Raw := Raw + 'default:' + NewLine;
            Raw := Raw + '    ${6:defaultStatement}' + NewLine;
            Raw := Raw + '    break;' + NewLine;
            Raw := Raw + '}' + NewLine + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 4) = 'do {') THEN
            Raw := 'do {' + NewLine;
            Raw := Raw + '    ${1:statement}' + NewLine;
            Raw := Raw + '} while (${2:condition});' + NewLine;
            Raw := Raw + '$0';
            RewriteDone := 1;
        END;
        IF (RewriteDone = 0) AND (COPY(Raw, 1, 5) = 'try {') THEN
            Raw := 'try {' + NewLine;
            Raw := Raw + '    ${1:statement}' + NewLine;
            Raw := Raw + '} catch (${2:const std::exception &ex}) {' + NewLine;
            Raw := Raw + '    $0' + NewLine;
            Raw := Raw + '}';
            RewriteDone := 1;
        END;
    END;

    Output := '';
    Count := 0;
    RawLen := LENGTH(Raw);
    I := 1;

    IF Format <> 2 THEN
        Output := Raw;
    ELSE
        WHILE I <= RawLen DO
            Ch := COPY(Raw, I, 1);
            IF Ch = '\' THEN
                IF I < RawLen THEN
                    NextCh := COPY(Raw, I + 1, 1);
                    IF (NextCh = '$') OR (NextCh = '}') OR (NextCh = '\') THEN
                        Output := Output + NextCh;
                        I := I + 2;
                    ELSE
                        Output := Output + Ch;
                        I := I + 1;
                    END;
                ELSE
                    Output := Output + Ch;
                    I := I + 1;
                END;
            ELSE
                IF Ch <> '$' THEN
                    Output := Output + Ch;
                    I := I + 1;
                ELSE
                    IF I >= RawLen THEN
                        Output := Output + Ch;
                        I := I + 1;
                    ELSE
                        NextCh := COPY(Raw, I + 1, 1);
                        IF POS(NextCh, Digits) > 0 THEN
                            Count := Count + 1;
                            KeySuffix := STR(Count);
                            Sidekick['placeholderStart' + KeySuffix] := LENGTH(Output);
                            Sidekick['placeholderEnd' + KeySuffix] := LENGTH(Output);
                            I := I + 1;
                            WHILE (I <= RawLen) AND (POS(COPY(Raw, I, 1), Digits) > 0) DO
                                I := I + 1;
                            END;
                        ELSE
                            IF NextCh <> '{' THEN
                                Output := Output + Ch;
                                I := I + 1;
                            ELSE
                                Tail := COPY(Raw, I + 2, RawLen);
                                CloseRel := POS('}', Tail);
                                IF CloseRel = 0 THEN
                                    Output := Output + Ch;
                                    I := I + 1;
                                ELSE
                                    ClosePos := I + 1 + CloseRel;
                                    Body := COPY(Raw, I + 2, ClosePos - I - 2);
                                    BodyLen := LENGTH(Body);
                                    BodyPos := 1;
                                    NumberText := '';
                                    WHILE (BodyPos <= BodyLen) AND (POS(COPY(Body, BodyPos, 1), Digits) > 0) DO
                                        NumberText := NumberText + COPY(Body, BodyPos, 1);
                                        BodyPos := BodyPos + 1;
                                    END;
                                    DefaultText := '';
                                    DigitDone := 0;
                                    IF LENGTH(NumberText) > 0 THEN
                                        IF (BodyPos <= BodyLen) AND (COPY(Body, BodyPos, 1) = ':') THEN
                                            DefaultText := COPY(Body, BodyPos + 1, BodyLen);
                                            DigitDone := 1;
                                        END;
                                        IF (DigitDone = 0) AND (BodyPos <= BodyLen) AND (COPY(Body, BodyPos, 1) = '|') THEN
                                            FirstChoice := COPY(Body, BodyPos + 1, BodyLen);
                                            CommaPos := POS(',', FirstChoice);
                                            EndBarPos := POS('|', FirstChoice);
                                            ChoiceEnd := LENGTH(FirstChoice) + 1;
                                            IF (CommaPos > 0) AND (CommaPos < ChoiceEnd) THEN
                                                ChoiceEnd := CommaPos;
                                            END;
                                            IF (EndBarPos > 0) AND (EndBarPos < ChoiceEnd) THEN
                                                ChoiceEnd := EndBarPos;
                                            END;
                                            DefaultText := COPY(FirstChoice, 1, ChoiceEnd - 1);
                                            DigitDone := 1;
                                        END;
                                        IF DigitDone = 0 THEN
                                            DefaultText := '';
                                        END;
                                    ELSE
                                        DefaultText := Body;
                                    END;
                                    StartOffset := LENGTH(Output);
                                    Output := Output + DefaultText;
                                    EndOffset := LENGTH(Output);
                                    Count := Count + 1;
                                    KeySuffix := STR(Count);
                                    Sidekick['placeholderStart' + KeySuffix] := StartOffset;
                                    Sidekick['placeholderEnd' + KeySuffix] := EndOffset;
                                    I := ClosePos + 1;
                                END;
                            END;
                        END;
                    END;
                END;
            END;
        END;
    END;

    Sidekick['available'] := 1;
    Sidekick['text'] := Output;
    Sidekick['placeholderCount'] := Count;
END;

END_MACRO;
