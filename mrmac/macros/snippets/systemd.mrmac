$MACRO REGISTER_SYSTEMD_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, SystemdSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Sd01);
Sd01['name'] := 'Systemd service';
Sd01['trigger'] := 'service';
Sd01['body'] := <<BODY
[Unit]
Description=Service description

[Service]
ExecStart=/usr/bin/command

[Install]
WantedBy=multi-user.target
BODY;
SystemdSnippets['SERVICE'] := Sd01;

DEF_HASH(Sd02);
Sd02['name'] := 'Systemd unit section';
Sd02['trigger'] := 'unit';
Sd02['body'] := <<BODY
[Unit]
Description=Description
After=network.target
BODY;
SystemdSnippets['UNIT'] := Sd02;

DEF_HASH(Sd03);
Sd03['name'] := 'Systemd service section';
Sd03['trigger'] := 'servicesection';
Sd03['body'] := <<BODY
[Service]
Type=simple
ExecStart=/usr/bin/command
BODY;
SystemdSnippets['SERVICESECTION'] := Sd03;

DEF_HASH(Sd04);
Sd04['name'] := 'Systemd install section';
Sd04['trigger'] := 'install';
Sd04['body'] := <<BODY
[Install]
WantedBy=multi-user.target
BODY;
SystemdSnippets['INSTALL'] := Sd04;

DEF_HASH(Sd05);
Sd05['name'] := 'Systemd oneshot';
Sd05['trigger'] := 'oneshot';
Sd05['body'] := <<BODY
[Service]
Type=oneshot
ExecStart=/usr/bin/command
RemainAfterExit=yes
BODY;
SystemdSnippets['ONESHOT'] := Sd05;

DEF_HASH(Sd06);
Sd06['name'] := 'Systemd forking';
Sd06['trigger'] := 'forking';
Sd06['body'] := <<BODY
[Service]
Type=forking
PIDFile=/run/name.pid
ExecStart=/usr/bin/daemon
BODY;
SystemdSnippets['FORKING'] := Sd06;

DEF_HASH(Sd07);
Sd07['name'] := 'Systemd notify';
Sd07['trigger'] := 'notify';
Sd07['body'] := <<BODY
[Service]
Type=notify
ExecStart=/usr/bin/daemon
BODY;
SystemdSnippets['NOTIFY'] := Sd07;

DEF_HASH(Sd08);
Sd08['name'] := 'Systemd restart';
Sd08['trigger'] := 'restart';
Sd08['body'] := <<BODY
Restart=on-failure
RestartSec=5s
BODY;
SystemdSnippets['RESTART'] := Sd08;

DEF_HASH(Sd09);
Sd09['name'] := 'Systemd environment';
Sd09['trigger'] := 'env';
Sd09['body'] := <<BODY
Environment=NAME=value
EnvironmentFile=-/etc/default/name
BODY;
SystemdSnippets['ENV'] := Sd09;

DEF_HASH(Sd10);
Sd10['name'] := 'Systemd user group';
Sd10['trigger'] := 'user';
Sd10['body'] := <<BODY
User=name
Group=name
BODY;
SystemdSnippets['USER'] := Sd10;

DEF_HASH(Sd11);
Sd11['name'] := 'Systemd working directory';
Sd11['trigger'] := 'workdir';
Sd11['body'] := <<BODY
WorkingDirectory=/var/lib/name
BODY;
SystemdSnippets['WORKDIR'] := Sd11;

DEF_HASH(Sd12);
Sd12['name'] := 'Systemd hardening';
Sd12['trigger'] := 'hardening';
Sd12['body'] := <<BODY
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
BODY;
SystemdSnippets['HARDENING'] := Sd12;

DEF_HASH(Sd13);
Sd13['name'] := 'Systemd network dependency';
Sd13['trigger'] := 'network';
Sd13['body'] := <<BODY
After=network-online.target
Wants=network-online.target
BODY;
SystemdSnippets['NETWORK'] := Sd13;

DEF_HASH(Sd14);
Sd14['name'] := 'Systemd timer';
Sd14['trigger'] := 'timer';
Sd14['body'] := <<BODY
[Unit]
Description=Timer description

[Timer]
OnCalendar=*-*-* 00:00:00
Persistent=true

[Install]
WantedBy=timers.target
BODY;
SystemdSnippets['TIMER'] := Sd14;

DEF_HASH(Sd15);
Sd15['name'] := 'Systemd timer section';
Sd15['trigger'] := 'timersection';
Sd15['body'] := <<BODY
[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
BODY;
SystemdSnippets['TIMERSECTION'] := Sd15;

DEF_HASH(Sd16);
Sd16['name'] := 'Systemd socket';
Sd16['trigger'] := 'socket';
Sd16['body'] := <<BODY
[Socket]
ListenStream=8080

[Install]
WantedBy=sockets.target
BODY;
SystemdSnippets['SOCKET'] := Sd16;

DEF_HASH(Sd17);
Sd17['name'] := 'Systemd path';
Sd17['trigger'] := 'path';
Sd17['body'] := <<BODY
[Path]
PathChanged=/path/to/watch

[Install]
WantedBy=multi-user.target
BODY;
SystemdSnippets['PATH'] := Sd17;

DEF_HASH(Sd18);
Sd18['name'] := 'Systemd mount';
Sd18['trigger'] := 'mount';
Sd18['body'] := <<BODY
[Mount]
What=/dev/disk/by-label/data
Where=/mnt/data
Type=ext4
BODY;
SystemdSnippets['MOUNT'] := Sd18;

DEF_HASH(Sd19);
Sd19['name'] := 'Systemd automount';
Sd19['trigger'] := 'automount';
Sd19['body'] := <<BODY
[Automount]
Where=/mnt/data

[Install]
WantedBy=multi-user.target
BODY;
SystemdSnippets['AUTOMOUNT'] := Sd19;

DEF_HASH(Sd20);
Sd20['name'] := 'Systemd target';
Sd20['trigger'] := 'target';
Sd20['body'] := <<BODY
[Unit]
Description=Target description
Requires=service.service
BODY;
SystemdSnippets['TARGET'] := Sd20;

DEF_HASH(Sd21);
Sd21['name'] := 'Systemd drop-in';
Sd21['trigger'] := 'dropin';
Sd21['body'] := <<BODY
[Service]
Environment=NAME=value
BODY;
SystemdSnippets['DROPIN'] := Sd21;

DEF_HASH(Sd22);
Sd22['name'] := 'Systemd override exec';
Sd22['trigger'] := 'override';
Sd22['body'] := <<BODY
[Service]
ExecStart=
ExecStart=/usr/bin/new-command
BODY;
SystemdSnippets['OVERRIDE'] := Sd22;

DEF_HASH(Sd23);
Sd23['name'] := 'Systemd logging';
Sd23['trigger'] := 'logging';
Sd23['body'] := <<BODY
StandardOutput=journal
StandardError=journal
SyslogIdentifier=name
BODY;
SystemdSnippets['LOGGING'] := Sd23;

DEF_HASH(Sd24);
Sd24['name'] := 'Systemd resource limits';
Sd24['trigger'] := 'limits';
Sd24['body'] := <<BODY
MemoryMax=512M
CPUQuota=50%
TasksMax=128
BODY;
SystemdSnippets['LIMITS'] := Sd24;

DEF_HASH(Sd25);
Sd25['name'] := 'Systemd sandbox paths';
Sd25['trigger'] := 'paths';
Sd25['body'] := <<BODY
ReadWritePaths=/var/lib/name
InaccessiblePaths=/home
BODY;
SystemdSnippets['PATHS'] := Sd25;

DEF_HASH(Sd26);
Sd26['name'] := 'Systemd watchdog';
Sd26['trigger'] := 'watchdog';
Sd26['body'] := <<BODY
WatchdogSec=30s
Restart=on-watchdog
BODY;
SystemdSnippets['WATCHDOG'] := Sd26;

DEF_HASH(Sd27);
Sd27['name'] := 'Systemd dependency';
Sd27['trigger'] := 'dependency';
Sd27['body'] := <<BODY
Requires=name.service
After=name.service
BODY;
SystemdSnippets['DEPENDENCY'] := Sd27;

DEF_HASH(Sd28);
Sd28['name'] := 'Systemd condition';
Sd28['trigger'] := 'condition';
Sd28['body'] := <<BODY
ConditionPathExists=/path
AssertPathIsDirectory=/path
BODY;
SystemdSnippets['CONDITION'] := Sd28;

DEF_HASH(Sd29);
Sd29['name'] := 'Systemd comment';
Sd29['trigger'] := 'comment';
Sd29['body'] := <<BODY
# description
BODY;
SystemdSnippets['COMMENT'] := Sd29;

DEF_HASH(Sd30);
Sd30['name'] := 'Systemd service template';
Sd30['trigger'] := 'template';
Sd30['body'] := <<BODY
[Unit]
Description=Instance %i

[Service]
ExecStart=/usr/bin/command %i
BODY;
SystemdSnippets['TEMPLATE'] := Sd30;

Snippets['SYSTEMD'] := SystemdSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'systemd^SYSTEMD_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'systemd^SYSTEMD_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO SYSTEMD_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO SYSTEMD_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('SYSTEMD');
END_MACRO;
