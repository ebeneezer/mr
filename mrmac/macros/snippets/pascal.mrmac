$MACRO REGISTER_PASCAL_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, PascalSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Pas01);
Pas01['name'] := 'Pascal program';
Pas01['trigger'] := 'program';
Pas01['body'] := <<BODY
program Name;

begin
end.
BODY;
PascalSnippets['PROGRAM'] := Pas01;

DEF_HASH(Pas02);
Pas02['name'] := 'Pascal unit';
Pas02['trigger'] := 'unit';
Pas02['body'] := <<BODY
unit Name;

interface

implementation

end.
BODY;
PascalSnippets['UNIT'] := Pas02;

DEF_HASH(Pas03);
Pas03['name'] := 'Pascal uses';
Pas03['trigger'] := 'uses';
Pas03['body'] := <<BODY
uses
  SysUtils;
BODY;
PascalSnippets['USES'] := Pas03;

DEF_HASH(Pas04);
Pas04['name'] := 'Pascal procedure';
Pas04['trigger'] := 'procedure';
Pas04['body'] := <<BODY
procedure Name;
begin
end;
BODY;
PascalSnippets['PROCEDURE'] := Pas04;

DEF_HASH(Pas05);
Pas05['name'] := 'Pascal function';
Pas05['trigger'] := 'function';
Pas05['body'] := <<BODY
function Name: Integer;
begin
  Result := 0;
end;
BODY;
PascalSnippets['FUNCTION'] := Pas05;

DEF_HASH(Pas06);
Pas06['name'] := 'Pascal class';
Pas06['trigger'] := 'class';
Pas06['body'] := <<BODY
type
  TName = class
  public
    constructor Create;
  end;
BODY;
PascalSnippets['CLASS'] := Pas06;

DEF_HASH(Pas07);
Pas07['name'] := 'Pascal record';
Pas07['trigger'] := 'record';
Pas07['body'] := <<BODY
type
  TName = record
    Value: Integer;
  end;
BODY;
PascalSnippets['RECORD'] := Pas07;

DEF_HASH(Pas08);
Pas08['name'] := 'Pascal enum';
Pas08['trigger'] := 'enum';
Pas08['body'] := <<BODY
type
  TName = (First, Second);
BODY;
PascalSnippets['ENUM'] := Pas08;

DEF_HASH(Pas09);
Pas09['name'] := 'Pascal const';
Pas09['trigger'] := 'const';
Pas09['body'] := <<BODY
const
  Name = 0;
BODY;
PascalSnippets['CONST'] := Pas09;

DEF_HASH(Pas10);
Pas10['name'] := 'Pascal var';
Pas10['trigger'] := 'var';
Pas10['body'] := <<BODY
var
  Value: Integer;
BODY;
PascalSnippets['VAR'] := Pas10;

DEF_HASH(Pas11);
Pas11['name'] := 'Pascal if';
Pas11['trigger'] := 'if';
Pas11['body'] := <<BODY
if Condition then
begin
end;
BODY;
PascalSnippets['IF'] := Pas11;

DEF_HASH(Pas12);
Pas12['name'] := 'Pascal if else';
Pas12['trigger'] := 'ifelse';
Pas12['body'] := <<BODY
if Condition then
begin
end
else
begin
end;
BODY;
PascalSnippets['IFELSE'] := Pas12;

DEF_HASH(Pas13);
Pas13['name'] := 'Pascal case';
Pas13['trigger'] := 'case';
Pas13['body'] := <<BODY
case Value of
  0:
    begin
    end;
else
end;
BODY;
PascalSnippets['CASE'] := Pas13;

DEF_HASH(Pas14);
Pas14['name'] := 'Pascal for';
Pas14['trigger'] := 'for';
Pas14['body'] := <<BODY
for I := 0 to Count - 1 do
begin
end;
BODY;
PascalSnippets['FOR'] := Pas14;

DEF_HASH(Pas15);
Pas15['name'] := 'Pascal downto';
Pas15['trigger'] := 'downto';
Pas15['body'] := <<BODY
for I := Count - 1 downto 0 do
begin
end;
BODY;
PascalSnippets['DOWNTO'] := Pas15;

DEF_HASH(Pas16);
Pas16['name'] := 'Pascal while';
Pas16['trigger'] := 'while';
Pas16['body'] := <<BODY
while Condition do
begin
end;
BODY;
PascalSnippets['WHILE'] := Pas16;

DEF_HASH(Pas17);
Pas17['name'] := 'Pascal repeat';
Pas17['trigger'] := 'repeat';
Pas17['body'] := <<BODY
repeat
until Condition;
BODY;
PascalSnippets['REPEAT'] := Pas17;

DEF_HASH(Pas18);
Pas18['name'] := 'Pascal try finally';
Pas18['trigger'] := 'tryfinally';
Pas18['body'] := <<BODY
try
finally
end;
BODY;
PascalSnippets['TRYFINALLY'] := Pas18;

DEF_HASH(Pas19);
Pas19['name'] := 'Pascal try except';
Pas19['trigger'] := 'tryexcept';
Pas19['body'] := <<BODY
try
except
  on E: Exception do
  begin
  end;
end;
BODY;
PascalSnippets['TRYEXCEPT'] := Pas19;

DEF_HASH(Pas20);
Pas20['name'] := 'Pascal with';
Pas20['trigger'] := 'with';
Pas20['body'] := <<BODY
with Value do
begin
end;
BODY;
PascalSnippets['WITH'] := Pas20;

DEF_HASH(Pas21);
Pas21['name'] := 'Pascal property';
Pas21['trigger'] := 'property';
Pas21['body'] := <<BODY
property Value: Integer read FValue write FValue;
BODY;
PascalSnippets['PROPERTY'] := Pas21;

DEF_HASH(Pas22);
Pas22['name'] := 'Pascal constructor';
Pas22['trigger'] := 'constructor';
Pas22['body'] := <<BODY
constructor TName.Create;
begin
  inherited Create;
end;
BODY;
PascalSnippets['CONSTRUCTOR'] := Pas22;

DEF_HASH(Pas23);
Pas23['name'] := 'Pascal destructor';
Pas23['trigger'] := 'destructor';
Pas23['body'] := <<BODY
destructor TName.Destroy;
begin
  inherited Destroy;
end;
BODY;
PascalSnippets['DESTRUCTOR'] := Pas23;

DEF_HASH(Pas24);
Pas24['name'] := 'Pascal interface';
Pas24['trigger'] := 'interface';
Pas24['body'] := <<BODY
type
  IName = interface
    procedure Execute;
  end;
BODY;
PascalSnippets['INTERFACE'] := Pas24;

DEF_HASH(Pas25);
Pas25['name'] := 'Pascal array';
Pas25['trigger'] := 'array';
Pas25['body'] := <<BODY
var
  Values: array of Integer;
BODY;
PascalSnippets['ARRAY'] := Pas25;

DEF_HASH(Pas26);
Pas26['name'] := 'Pascal writeln';
Pas26['trigger'] := 'writeln';
Pas26['body'] := <<BODY
WriteLn('Value: ', Value);
BODY;
PascalSnippets['WRITELN'] := Pas26;

DEF_HASH(Pas27);
Pas27['name'] := 'Pascal assert';
Pas27['trigger'] := 'assert';
Pas27['body'] := <<BODY
Assert(Condition);
BODY;
PascalSnippets['ASSERT'] := Pas27;

DEF_HASH(Pas28);
Pas28['name'] := 'Pascal include';
Pas28['trigger'] := 'include';
Pas28['body'] := <<BODY
{$I filename.inc}
BODY;
PascalSnippets['INCLUDE'] := Pas28;

DEF_HASH(Pas29);
Pas29['name'] := 'Pascal directive';
Pas29['trigger'] := 'directive';
Pas29['body'] := <<BODY
{$IFDEF DEBUG}
{$ENDIF}
BODY;
PascalSnippets['DIRECTIVE'] := Pas29;

DEF_HASH(Pas30);
Pas30['name'] := 'Pascal comment block';
Pas30['trigger'] := 'comment';
Pas30['body'] := <<BODY
{
  description
}
BODY;
PascalSnippets['COMMENT'] := Pas30;

Snippets['PASCAL'] := PascalSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'pascal^PASCAL_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'pascal^PASCAL_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO PASCAL_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO PASCAL_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('PASCAL');
END_MACRO;
