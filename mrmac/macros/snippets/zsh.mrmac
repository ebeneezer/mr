$MACRO REGISTER_ZSH_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, ZshSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Zs01);
Zs01['name'] := 'Zsh shebang';
Zs01['trigger'] := 'shebang';
Zs01['body'] := <<BODY
#!/usr/bin/env zsh
set -euo pipefail
BODY;
ZshSnippets['SHEBANG'] := Zs01;

DEF_HASH(Zs02);
Zs02['name'] := 'Zsh emulate';
Zs02['trigger'] := 'emulate';
Zs02['body'] := <<BODY
emulate -L zsh
setopt err_return no_unset pipe_fail
BODY;
ZshSnippets['EMULATE'] := Zs02;

DEF_HASH(Zs03);
Zs03['name'] := 'Zsh function';
Zs03['trigger'] := 'function';
Zs03['body'] := <<BODY
function name() {
  emulate -L zsh
}
BODY;
ZshSnippets['FUNCTION'] := Zs03;

DEF_HASH(Zs04);
Zs04['name'] := 'Zsh main';
Zs04['trigger'] := 'main';
Zs04['body'] := <<BODY
function main() {
  return 0
}

main "$@"
BODY;
ZshSnippets['MAIN'] := Zs04;

DEF_HASH(Zs05);
Zs05['name'] := 'Zsh local';
Zs05['trigger'] := 'local';
Zs05['body'] := <<BODY
local value="${1:-default}"
BODY;
ZshSnippets['LOCAL'] := Zs05;

DEF_HASH(Zs06);
Zs06['name'] := 'Zsh if';
Zs06['trigger'] := 'if';
Zs06['body'] := <<BODY
if [[ condition ]]; then
fi
BODY;
ZshSnippets['IF'] := Zs06;

DEF_HASH(Zs07);
Zs07['name'] := 'Zsh case';
Zs07['trigger'] := 'case';
Zs07['body'] := <<BODY
case "$value" in
  pattern)
    ;;
  *)
    ;;
esac
BODY;
ZshSnippets['CASE'] := Zs07;

DEF_HASH(Zs08);
Zs08['name'] := 'Zsh for';
Zs08['trigger'] := 'for';
Zs08['body'] := <<BODY
for item in "${items[@]}"; do
done
BODY;
ZshSnippets['FOR'] := Zs08;

DEF_HASH(Zs09);
Zs09['name'] := 'Zsh repeat';
Zs09['trigger'] := 'repeat';
Zs09['body'] := <<BODY
repeat 10; do
done
BODY;
ZshSnippets['REPEAT'] := Zs09;

DEF_HASH(Zs10);
Zs10['name'] := 'Zsh while';
Zs10['trigger'] := 'while';
Zs10['body'] := <<BODY
while [[ condition ]]; do
done
BODY;
ZshSnippets['WHILE'] := Zs10;

DEF_HASH(Zs11);
Zs11['name'] := 'Zsh until';
Zs11['trigger'] := 'until';
Zs11['body'] := <<BODY
until [[ condition ]]; do
done
BODY;
ZshSnippets['UNTIL'] := Zs11;

DEF_HASH(Zs12);
Zs12['name'] := 'Zsh read loop';
Zs12['trigger'] := 'readloop';
Zs12['body'] := <<BODY
while IFS= read -r line; do
done < "$file"
BODY;
ZshSnippets['READLOOP'] := Zs12;

DEF_HASH(Zs13);
Zs13['name'] := 'Zsh array';
Zs13['trigger'] := 'array';
Zs13['body'] := <<BODY
typeset -a values
values+=("$value")
BODY;
ZshSnippets['ARRAY'] := Zs13;

DEF_HASH(Zs14);
Zs14['name'] := 'Zsh associative array';
Zs14['trigger'] := 'assoc';
Zs14['body'] := <<BODY
typeset -A values
values[$key]="$value"
BODY;
ZshSnippets['ASSOC'] := Zs14;

DEF_HASH(Zs15);
Zs15['name'] := 'Zsh glob qualifier';
Zs15['trigger'] := 'glob';
Zs15['body'] := <<BODY
for file in ./**/*.txt(.); do
done
BODY;
ZshSnippets['GLOB'] := Zs15;

DEF_HASH(Zs16);
Zs16['name'] := 'Zsh zparseopts';
Zs16['trigger'] := 'opts';
Zs16['body'] := <<BODY
zparseopts -D -E h=help v=verbose
BODY;
ZshSnippets['OPTS'] := Zs16;

DEF_HASH(Zs17);
Zs17['name'] := 'Zsh usage';
Zs17['trigger'] := 'usage';
Zs17['body'] := <<BODY
function usage() {
  print -u2 "usage: ${0:t} [options]"
}
BODY;
ZshSnippets['USAGE'] := Zs17;

DEF_HASH(Zs18);
Zs18['name'] := 'Zsh trap';
Zs18['trigger'] := 'trap';
Zs18['body'] := <<BODY
trap 'cleanup' EXIT
BODY;
ZshSnippets['TRAP'] := Zs18;

DEF_HASH(Zs19);
Zs19['name'] := 'Zsh tempdir';
Zs19['trigger'] := 'tempdir';
Zs19['body'] := <<BODY
local tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
BODY;
ZshSnippets['TEMPDIR'] := Zs19;

DEF_HASH(Zs20);
Zs20['name'] := 'Zsh command check';
Zs20['trigger'] := 'command';
Zs20['body'] := <<BODY
if ! (( $+commands[tool] )); then
  print -u2 "missing tool: tool"
  return 1
fi
BODY;
ZshSnippets['COMMAND'] := Zs20;

DEF_HASH(Zs21);
Zs21['name'] := 'Zsh here doc';
Zs21['trigger'] := 'heredoc';
Zs21['body'] := <<BODY
cat <<'TEXT'
content
TEXT
BODY;
ZshSnippets['HEREDOC'] := Zs21;

DEF_HASH(Zs22);
Zs22['name'] := 'Zsh process substitution';
Zs22['trigger'] := 'procsub';
Zs22['body'] := <<BODY
diff <(command_one) <(command_two)
BODY;
ZshSnippets['PROCSUB'] := Zs22;

DEF_HASH(Zs23);
Zs23['name'] := 'Zsh parameter default';
Zs23['trigger'] := 'default';
Zs23['body'] := <<BODY
local value="${name:-default}"
BODY;
ZshSnippets['DEFAULT'] := Zs23;

DEF_HASH(Zs24);
Zs24['name'] := 'Zsh parameter require';
Zs24['trigger'] := 'require';
Zs24['body'] := <<BODY
local value="${name:?name is required}"
BODY;
ZshSnippets['REQUIRE'] := Zs24;

DEF_HASH(Zs25);
Zs25['name'] := 'Zsh modifier';
Zs25['trigger'] := 'modifier';
Zs25['body'] := <<BODY
local base="${path:t}"
local dir="${path:h}"
BODY;
ZshSnippets['MODIFIER'] := Zs25;

DEF_HASH(Zs26);
Zs26['name'] := 'Zsh arithmetic';
Zs26['trigger'] := 'arith';
Zs26['body'] := <<BODY
(( count += 1 ))
BODY;
ZshSnippets['ARITH'] := Zs26;

DEF_HASH(Zs27);
Zs27['name'] := 'Zsh print';
Zs27['trigger'] := 'print';
Zs27['body'] := <<BODY
print -r -- "$message"
BODY;
ZshSnippets['PRINT'] := Zs27;

DEF_HASH(Zs28);
Zs28['name'] := 'Zsh autoload';
Zs28['trigger'] := 'autoload';
Zs28['body'] := <<BODY
autoload -Uz compinit
compinit
BODY;
ZshSnippets['AUTOLOAD'] := Zs28;

DEF_HASH(Zs29);
Zs29['name'] := 'Zsh completion';
Zs29['trigger'] := 'compdef';
Zs29['body'] := <<BODY
#compdef command
_arguments '1:argument:_files'
BODY;
ZshSnippets['COMPDEF'] := Zs29;

DEF_HASH(Zs30);
Zs30['name'] := 'Zsh comment block';
Zs30['trigger'] := 'comment';
Zs30['body'] := <<BODY
# -----------------------------------------------------------------------------
# description
# -----------------------------------------------------------------------------
BODY;
ZshSnippets['COMMENT'] := Zs30;

Snippets['ZSH'] := ZshSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'zsh^ZSH_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'zsh^ZSH_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO ZSH_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO ZSH_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('ZSH');
END_MACRO;
