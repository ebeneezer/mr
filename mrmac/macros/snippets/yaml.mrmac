$MACRO REGISTER_YAML_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, YamlSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Ym01);
Ym01['name'] := 'YAML document';
Ym01['trigger'] := 'doc';
Ym01['body'] := <<BODY
---
name: value
BODY;
YamlSnippets['DOC'] := Ym01;

DEF_HASH(Ym02);
Ym02['name'] := 'YAML mapping';
Ym02['trigger'] := 'map';
Ym02['body'] := <<BODY
name:
  key: value
BODY;
YamlSnippets['MAP'] := Ym02;

DEF_HASH(Ym03);
Ym03['name'] := 'YAML sequence';
Ym03['trigger'] := 'seq';
Ym03['body'] := <<BODY
items:
  - value
BODY;
YamlSnippets['SEQ'] := Ym03;

DEF_HASH(Ym04);
Ym04['name'] := 'YAML object list';
Ym04['trigger'] := 'objects';
Ym04['body'] := <<BODY
items:
  - name: value
    enabled: true
BODY;
YamlSnippets['OBJECTS'] := Ym04;

DEF_HASH(Ym05);
Ym05['name'] := 'YAML multiline literal';
Ym05['trigger'] := 'literal';
Ym05['body'] := <<BODY
description: |
  Line one.
  Line two.
BODY;
YamlSnippets['LITERAL'] := Ym05;

DEF_HASH(Ym06);
Ym06['name'] := 'YAML folded text';
Ym06['trigger'] := 'folded';
Ym06['body'] := <<BODY
description: >
  Line one
  line two.
BODY;
YamlSnippets['FOLDED'] := Ym06;

DEF_HASH(Ym07);
Ym07['name'] := 'YAML anchor';
Ym07['trigger'] := 'anchor';
Ym07['body'] := <<BODY
defaults: &defaults
  enabled: true
item:
  <<: *defaults
BODY;
YamlSnippets['ANCHOR'] := Ym07;

DEF_HASH(Ym08);
Ym08['name'] := 'YAML null';
Ym08['trigger'] := 'null';
Ym08['body'] := <<BODY
value: null
BODY;
YamlSnippets['NULL'] := Ym08;

DEF_HASH(Ym09);
Ym09['name'] := 'YAML boolean';
Ym09['trigger'] := 'bool';
Ym09['body'] := <<BODY
enabled: true
BODY;
YamlSnippets['BOOL'] := Ym09;

DEF_HASH(Ym10);
Ym10['name'] := 'YAML number';
Ym10['trigger'] := 'number';
Ym10['body'] := <<BODY
count: 0
BODY;
YamlSnippets['NUMBER'] := Ym10;

DEF_HASH(Ym11);
Ym11['name'] := 'YAML environment';
Ym11['trigger'] := 'env';
Ym11['body'] := <<BODY
environment:
  NAME: value
BODY;
YamlSnippets['ENV'] := Ym11;

DEF_HASH(Ym12);
Ym12['name'] := 'YAML matrix';
Ym12['trigger'] := 'matrix';
Ym12['body'] := <<BODY
strategy:
  matrix:
    os: [ubuntu-latest]
BODY;
YamlSnippets['MATRIX'] := Ym12;

DEF_HASH(Ym13);
Ym13['name'] := 'YAML GitHub workflow';
Ym13['trigger'] := 'workflow';
Ym13['body'] := <<BODY
name: CI
on:
  push:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
BODY;
YamlSnippets['WORKFLOW'] := Ym13;

DEF_HASH(Ym14);
Ym14['name'] := 'YAML GitHub step';
Ym14['trigger'] := 'step';
Ym14['body'] := <<BODY
- name: Run command
  run: make test
BODY;
YamlSnippets['STEP'] := Ym14;

DEF_HASH(Ym15);
Ym15['name'] := 'YAML Docker Compose';
Ym15['trigger'] := 'compose';
Ym15['body'] := <<BODY
services:
  app:
    image: image:tag
    ports:
      - "8080:8080"
BODY;
YamlSnippets['COMPOSE'] := Ym15;

DEF_HASH(Ym16);
Ym16['name'] := 'YAML Kubernetes pod';
Ym16['trigger'] := 'pod';
Ym16['body'] := <<BODY
apiVersion: v1
kind: Pod
metadata:
  name: app
spec:
  containers:
    - name: app
      image: image:tag
BODY;
YamlSnippets['POD'] := Ym16;

DEF_HASH(Ym17);
Ym17['name'] := 'YAML Kubernetes service';
Ym17['trigger'] := 'service';
Ym17['body'] := <<BODY
apiVersion: v1
kind: Service
metadata:
  name: app
spec:
  ports:
    - port: 80
BODY;
YamlSnippets['SERVICE'] := Ym17;

DEF_HASH(Ym18);
Ym18['name'] := 'YAML Kubernetes deployment';
Ym18['trigger'] := 'deployment';
Ym18['body'] := <<BODY
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
spec:
  replicas: 1
BODY;
YamlSnippets['DEPLOYMENT'] := Ym18;

DEF_HASH(Ym19);
Ym19['name'] := 'YAML config map';
Ym19['trigger'] := 'configmap';
Ym19['body'] := <<BODY
apiVersion: v1
kind: ConfigMap
metadata:
  name: config
data:
  key: value
BODY;
YamlSnippets['CONFIGMAP'] := Ym19;

DEF_HASH(Ym20);
Ym20['name'] := 'YAML secret';
Ym20['trigger'] := 'secret';
Ym20['body'] := <<BODY
apiVersion: v1
kind: Secret
metadata:
  name: secret
stringData:
  key: value
BODY;
YamlSnippets['SECRET'] := Ym20;

DEF_HASH(Ym21);
Ym21['name'] := 'YAML Ansible play';
Ym21['trigger'] := 'play';
Ym21['body'] := <<BODY
- name: Play name
  hosts: all
  tasks:
    - name: Task name
      debug:
        msg: hello
BODY;
YamlSnippets['PLAY'] := Ym21;

DEF_HASH(Ym22);
Ym22['name'] := 'YAML Ansible task';
Ym22['trigger'] := 'task';
Ym22['body'] := <<BODY
- name: Task name
  ansible.builtin.command: command
BODY;
YamlSnippets['TASK'] := Ym22;

DEF_HASH(Ym23);
Ym23['name'] := 'YAML OpenAPI root';
Ym23['trigger'] := 'openapi';
Ym23['body'] := <<BODY
openapi: 3.1.0
info:
  title: API
  version: 0.1.0
paths: {}
BODY;
YamlSnippets['OPENAPI'] := Ym23;

DEF_HASH(Ym24);
Ym24['name'] := 'YAML OpenAPI path';
Ym24['trigger'] := 'path';
Ym24['body'] := <<BODY
/resource:
  get:
    responses:
      "200":
        description: OK
BODY;
YamlSnippets['PATH'] := Ym24;

DEF_HASH(Ym25);
Ym25['name'] := 'YAML GitLab job';
Ym25['trigger'] := 'gitlab';
Ym25['body'] := <<BODY
job:
  stage: test
  script:
    - make test
BODY;
YamlSnippets['GITLAB'] := Ym25;

DEF_HASH(Ym26);
Ym26['name'] := 'YAML Helm values';
Ym26['trigger'] := 'helm';
Ym26['body'] := <<BODY
replicaCount: 1
image:
  repository: app
  tag: latest
BODY;
YamlSnippets['HELM'] := Ym26;

DEF_HASH(Ym27);
Ym27['name'] := 'YAML logging';
Ym27['trigger'] := 'logging';
Ym27['body'] := <<BODY
logging:
  level: info
  format: text
BODY;
YamlSnippets['LOGGING'] := Ym27;

DEF_HASH(Ym28);
Ym28['name'] := 'YAML resources';
Ym28['trigger'] := 'resources';
Ym28['body'] := <<BODY
resources:
  requests:
    cpu: 100m
    memory: 128Mi
BODY;
YamlSnippets['RESOURCES'] := Ym28;

DEF_HASH(Ym29);
Ym29['name'] := 'YAML comment';
Ym29['trigger'] := 'comment';
Ym29['body'] := <<BODY
# description
BODY;
YamlSnippets['COMMENT'] := Ym29;

DEF_HASH(Ym30);
Ym30['name'] := 'YAML document end';
Ym30['trigger'] := 'end';
Ym30['body'] := <<BODY
...
BODY;
YamlSnippets['END'] := Ym30;

Snippets['YAML'] := YamlSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'yaml^YAML_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'yaml^YAML_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO YAML_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO YAML_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('YAML');
END_MACRO;
