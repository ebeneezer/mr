$MACRO REGISTER_XML_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, XmlSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Xml01);
Xml01['name'] := 'XML declaration';
Xml01['trigger'] := 'decl';
Xml01['body'] := <<BODY
<?xml version="1.0" encoding="UTF-8"?>
BODY;
XmlSnippets['DECL'] := Xml01;

DEF_HASH(Xml02);
Xml02['name'] := 'XML element';
Xml02['trigger'] := 'element';
Xml02['body'] := <<BODY
<element>value</element>
BODY;
XmlSnippets['ELEMENT'] := Xml02;

DEF_HASH(Xml03);
Xml03['name'] := 'XML empty element';
Xml03['trigger'] := 'empty';
Xml03['body'] := <<BODY
<element />
BODY;
XmlSnippets['EMPTY'] := Xml03;

DEF_HASH(Xml04);
Xml04['name'] := 'XML attribute';
Xml04['trigger'] := 'attr';
Xml04['body'] := <<BODY
<element name="value">text</element>
BODY;
XmlSnippets['ATTR'] := Xml04;

DEF_HASH(Xml05);
Xml05['name'] := 'XML nested';
Xml05['trigger'] := 'nested';
Xml05['body'] := <<BODY
<parent>
  <child>value</child>
</parent>
BODY;
XmlSnippets['NESTED'] := Xml05;

DEF_HASH(Xml06);
Xml06['name'] := 'XML list';
Xml06['trigger'] := 'list';
Xml06['body'] := <<BODY
<items>
  <item>value</item>
</items>
BODY;
XmlSnippets['LIST'] := Xml06;

DEF_HASH(Xml07);
Xml07['name'] := 'XML namespace';
Xml07['trigger'] := 'namespace';
Xml07['body'] := <<BODY
<root xmlns="https://example.com/schema">
</root>
BODY;
XmlSnippets['NAMESPACE'] := Xml07;

DEF_HASH(Xml08);
Xml08['name'] := 'XML namespace prefix';
Xml08['trigger'] := 'prefix';
Xml08['body'] := <<BODY
<x:root xmlns:x="https://example.com/schema">
</x:root>
BODY;
XmlSnippets['PREFIX'] := Xml08;

DEF_HASH(Xml09);
Xml09['name'] := 'XML comment';
Xml09['trigger'] := 'comment';
Xml09['body'] := <<BODY
<!-- description -->
BODY;
XmlSnippets['COMMENT'] := Xml09;

DEF_HASH(Xml10);
Xml10['name'] := 'XML CDATA';
Xml10['trigger'] := 'cdata';
Xml10['body'] := <<BODY
<![CDATA[
content
]]>
BODY;
XmlSnippets['CDATA'] := Xml10;

DEF_HASH(Xml11);
Xml11['name'] := 'XML doctype';
Xml11['trigger'] := 'doctype';
Xml11['body'] := <<BODY
<!DOCTYPE root>
BODY;
XmlSnippets['DOCTYPE'] := Xml11;

DEF_HASH(Xml12);
Xml12['name'] := 'XML processing instruction';
Xml12['trigger'] := 'pi';
Xml12['body'] := <<BODY
<?target instruction?>
BODY;
XmlSnippets['PI'] := Xml12;

DEF_HASH(Xml13);
Xml13['name'] := 'XML stylesheet';
Xml13['trigger'] := 'stylesheet';
Xml13['body'] := <<BODY
<?xml-stylesheet type="text/xsl" href="style.xsl"?>
BODY;
XmlSnippets['STYLESHEET'] := Xml13;

DEF_HASH(Xml14);
Xml14['name'] := 'XML schema root';
Xml14['trigger'] := 'schema';
Xml14['body'] := <<BODY
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
</xs:schema>
BODY;
XmlSnippets['SCHEMA'] := Xml14;

DEF_HASH(Xml15);
Xml15['name'] := 'XML schema element';
Xml15['trigger'] := 'xselement';
Xml15['body'] := <<BODY
<xs:element name="name" type="xs:string" />
BODY;
XmlSnippets['XSELEMENT'] := Xml15;

DEF_HASH(Xml16);
Xml16['name'] := 'XML schema complex type';
Xml16['trigger'] := 'complex';
Xml16['body'] := <<BODY
<xs:complexType name="Name">
  <xs:sequence>
  </xs:sequence>
</xs:complexType>
BODY;
XmlSnippets['COMPLEX'] := Xml16;

DEF_HASH(Xml17);
Xml17['name'] := 'XML schema attribute';
Xml17['trigger'] := 'xsattr';
Xml17['body'] := <<BODY
<xs:attribute name="name" type="xs:string" use="optional" />
BODY;
XmlSnippets['XSATTR'] := Xml17;

DEF_HASH(Xml18);
Xml18['name'] := 'XML HTML page';
Xml18['trigger'] := 'html';
Xml18['body'] := <<BODY
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Title</title>
  </head>
  <body>
  </body>
</html>
BODY;
XmlSnippets['HTML'] := Xml18;

DEF_HASH(Xml19);
Xml19['name'] := 'XML HTML link';
Xml19['trigger'] := 'link';
Xml19['body'] := <<BODY
<a href="https://example.com">label</a>
BODY;
XmlSnippets['LINK'] := Xml19;

DEF_HASH(Xml20);
Xml20['name'] := 'XML HTML script';
Xml20['trigger'] := 'script';
Xml20['body'] := <<BODY
<script src="script.js"></script>
BODY;
XmlSnippets['SCRIPT'] := Xml20;

DEF_HASH(Xml21);
Xml21['name'] := 'XML SVG root';
Xml21['trigger'] := 'svg';
Xml21['body'] := <<BODY
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
</svg>
BODY;
XmlSnippets['SVG'] := Xml21;

DEF_HASH(Xml22);
Xml22['name'] := 'XML SVG path';
Xml22['trigger'] := 'path';
Xml22['body'] := <<BODY
<path d="M 0 0 L 100 100" />
BODY;
XmlSnippets['PATH'] := Xml22;

DEF_HASH(Xml23);
Xml23['name'] := 'XML RSS';
Xml23['trigger'] := 'rss';
Xml23['body'] := <<BODY
<rss version="2.0">
  <channel>
    <title>Title</title>
  </channel>
</rss>
BODY;
XmlSnippets['RSS'] := Xml23;

DEF_HASH(Xml24);
Xml24['name'] := 'XML Maven project';
Xml24['trigger'] := 'pom';
Xml24['body'] := <<BODY
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>group</groupId>
  <artifactId>artifact</artifactId>
  <version>0.1.0</version>
</project>
BODY;
XmlSnippets['POM'] := Xml24;

DEF_HASH(Xml25);
Xml25['name'] := 'XML plist';
Xml25['trigger'] := 'plist';
Xml25['body'] := <<BODY
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
</dict>
</plist>
BODY;
XmlSnippets['PLIST'] := Xml25;

DEF_HASH(Xml26);
Xml26['name'] := 'XML plist key';
Xml26['trigger'] := 'plistkey';
Xml26['body'] := <<BODY
<key>Name</key>
<string>Value</string>
BODY;
XmlSnippets['PLISTKEY'] := Xml26;

DEF_HASH(Xml27);
Xml27['name'] := 'XML Android manifest';
Xml27['trigger'] := 'manifest';
Xml27['body'] := <<BODY
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
  </application>
</manifest>
BODY;
XmlSnippets['MANIFEST'] := Xml27;

DEF_HASH(Xml28);
Xml28['name'] := 'XML logback';
Xml28['trigger'] := 'logback';
Xml28['body'] := <<BODY
<configuration>
  <root level="INFO">
  </root>
</configuration>
BODY;
XmlSnippets['LOGBACK'] := Xml28;

DEF_HASH(Xml29);
Xml29['name'] := 'XML entity';
Xml29['trigger'] := 'entity';
Xml29['body'] := <<BODY
&amp;
BODY;
XmlSnippets['ENTITY'] := Xml29;

DEF_HASH(Xml30);
Xml30['name'] := 'XML document';
Xml30['trigger'] := 'doc';
Xml30['body'] := <<BODY
<?xml version="1.0" encoding="UTF-8"?>
<root>
</root>
BODY;
XmlSnippets['DOC'] := Xml30;

Snippets['XML'] := XmlSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'xml^XML_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'xml^XML_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO XML_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO XML_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('XML');
END_MACRO;
