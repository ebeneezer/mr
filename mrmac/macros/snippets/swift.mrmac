$MACRO REGISTER_SWIFT_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, SwiftSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Sw01);
Sw01['name'] := 'Swift import';
Sw01['trigger'] := 'import';
Sw01['body'] := <<BODY
import Foundation
BODY;
SwiftSnippets['IMPORT'] := Sw01;

DEF_HASH(Sw02);
Sw02['name'] := 'Swift class';
Sw02['trigger'] := 'class';
Sw02['body'] := <<BODY
final class Name {
	init() {
	}
}
BODY;
SwiftSnippets['CLASS'] := Sw02;

DEF_HASH(Sw03);
Sw03['name'] := 'Swift struct';
Sw03['trigger'] := 'struct';
Sw03['body'] := <<BODY
struct Name {
	let value: Int
}
BODY;
SwiftSnippets['STRUCT'] := Sw03;

DEF_HASH(Sw04);
Sw04['name'] := 'Swift enum';
Sw04['trigger'] := 'enum';
Sw04['body'] := <<BODY
enum Name {
	case first
	case second
}
BODY;
SwiftSnippets['ENUM'] := Sw04;

DEF_HASH(Sw05);
Sw05['name'] := 'Swift protocol';
Sw05['trigger'] := 'protocol';
Sw05['body'] := <<BODY
protocol Name {
	func value() -> Int
}
BODY;
SwiftSnippets['PROTOCOL'] := Sw05;

DEF_HASH(Sw06);
Sw06['name'] := 'Swift extension';
Sw06['trigger'] := 'extension';
Sw06['body'] := <<BODY
extension Type {
}
BODY;
SwiftSnippets['EXTENSION'] := Sw06;

DEF_HASH(Sw07);
Sw07['name'] := 'Swift function';
Sw07['trigger'] := 'func';
Sw07['body'] := <<BODY
func name() -> Int {
	return 0
}
BODY;
SwiftSnippets['FUNC'] := Sw07;

DEF_HASH(Sw08);
Sw08['name'] := 'Swift method';
Sw08['trigger'] := 'method';
Sw08['body'] := <<BODY
func methodName() {
}
BODY;
SwiftSnippets['METHOD'] := Sw08;

DEF_HASH(Sw09);
Sw09['name'] := 'Swift init';
Sw09['trigger'] := 'init';
Sw09['body'] := <<BODY
init(value: Int) {
	self.value = value
}
BODY;
SwiftSnippets['INIT'] := Sw09;

DEF_HASH(Sw10);
Sw10['name'] := 'Swift property';
Sw10['trigger'] := 'property';
Sw10['body'] := <<BODY
var value: Int {
	get { storage }
	set { storage = newValue }
}
BODY;
SwiftSnippets['PROPERTY'] := Sw10;

DEF_HASH(Sw11);
Sw11['name'] := 'Swift if';
Sw11['trigger'] := 'if';
Sw11['body'] := <<BODY
if condition {
}
BODY;
SwiftSnippets['IF'] := Sw11;

DEF_HASH(Sw12);
Sw12['name'] := 'Swift guard';
Sw12['trigger'] := 'guard';
Sw12['body'] := <<BODY
guard condition else {
	return
}
BODY;
SwiftSnippets['GUARD'] := Sw12;

DEF_HASH(Sw13);
Sw13['name'] := 'Swift switch';
Sw13['trigger'] := 'switch';
Sw13['body'] := <<BODY
switch value {
case .first:
	break
default:
	break
}
BODY;
SwiftSnippets['SWITCH'] := Sw13;

DEF_HASH(Sw14);
Sw14['name'] := 'Swift for';
Sw14['trigger'] := 'for';
Sw14['body'] := <<BODY
for item in items {
}
BODY;
SwiftSnippets['FOR'] := Sw14;

DEF_HASH(Sw15);
Sw15['name'] := 'Swift while';
Sw15['trigger'] := 'while';
Sw15['body'] := <<BODY
while condition {
}
BODY;
SwiftSnippets['WHILE'] := Sw15;

DEF_HASH(Sw16);
Sw16['name'] := 'Swift do catch';
Sw16['trigger'] := 'do';
Sw16['body'] := <<BODY
do {
	try operation()
} catch {
}
BODY;
SwiftSnippets['DO'] := Sw16;

DEF_HASH(Sw17);
Sw17['name'] := 'Swift optional binding';
Sw17['trigger'] := 'iflet';
Sw17['body'] := <<BODY
if let value = optionalValue {
}
BODY;
SwiftSnippets['IFLET'] := Sw17;

DEF_HASH(Sw18);
Sw18['name'] := 'Swift guard let';
Sw18['trigger'] := 'guardlet';
Sw18['body'] := <<BODY
guard let value = optionalValue else {
	return
}
BODY;
SwiftSnippets['GUARDLET'] := Sw18;

DEF_HASH(Sw19);
Sw19['name'] := 'Swift closure';
Sw19['trigger'] := 'closure';
Sw19['body'] := <<BODY
let closure: (Int) -> Int = { value in
	return value
}
BODY;
SwiftSnippets['CLOSURE'] := Sw19;

DEF_HASH(Sw20);
Sw20['name'] := 'Swift async function';
Sw20['trigger'] := 'async';
Sw20['body'] := <<BODY
func name() async throws -> Value {
	try await operation()
}
BODY;
SwiftSnippets['ASYNC'] := Sw20;

DEF_HASH(Sw21);
Sw21['name'] := 'Swift task';
Sw21['trigger'] := 'task';
Sw21['body'] := <<BODY
Task {
	await operation()
}
BODY;
SwiftSnippets['TASK'] := Sw21;

DEF_HASH(Sw22);
Sw22['name'] := 'Swift result';
Sw22['trigger'] := 'result';
Sw22['body'] := <<BODY
let result: Result<Value, Error> = .success(value)
BODY;
SwiftSnippets['RESULT'] := Sw22;

DEF_HASH(Sw23);
Sw23['name'] := 'Swift array';
Sw23['trigger'] := 'array';
Sw23['body'] := <<BODY
var values: [Value] = []
values.append(value)
BODY;
SwiftSnippets['ARRAY'] := Sw23;

DEF_HASH(Sw24);
Sw24['name'] := 'Swift dictionary';
Sw24['trigger'] := 'dict';
Sw24['body'] := <<BODY
var values: [Key: Value] = [:]
values[key] = value
BODY;
SwiftSnippets['DICT'] := Sw24;

DEF_HASH(Sw25);
Sw25['name'] := 'Swift defer';
Sw25['trigger'] := 'defer';
Sw25['body'] := <<BODY
defer {
}
BODY;
SwiftSnippets['DEFER'] := Sw25;

DEF_HASH(Sw26);
Sw26['name'] := 'Swift typealias';
Sw26['trigger'] := 'typealias';
Sw26['body'] := <<BODY
typealias Name = ExistingType
BODY;
SwiftSnippets['TYPEALIAS'] := Sw26;

DEF_HASH(Sw27);
Sw27['name'] := 'Swift availability';
Sw27['trigger'] := 'available';
Sw27['body'] := <<BODY
if #available(macOS 13.0, *) {
}
BODY;
SwiftSnippets['AVAILABLE'] := Sw27;

DEF_HASH(Sw28);
Sw28['name'] := 'Swift XCTest';
Sw28['trigger'] := 'test';
Sw28['body'] := <<BODY
func testName() throws {
	XCTAssertEqual(actual, expected)
}
BODY;
SwiftSnippets['TEST'] := Sw28;

DEF_HASH(Sw29);
Sw29['name'] := 'Swift print';
Sw29['trigger'] := 'print';
Sw29['body'] := <<BODY
print("\(name): \(value)")
BODY;
SwiftSnippets['PRINT'] := Sw29;

DEF_HASH(Sw30);
Sw30['name'] := 'Swift comment block';
Sw30['trigger'] := 'comment';
Sw30['body'] := <<BODY
/*
 description
 */
BODY;
SwiftSnippets['COMMENT'] := Sw30;

Snippets['SWIFT'] := SwiftSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'swift^SWIFT_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'swift^SWIFT_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO SWIFT_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO SWIFT_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('SWIFT');
END_MACRO;
