$MACRO REGISTER_CPP_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, CppSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Cpp01);
Cpp01['name'] := 'C++ include';
Cpp01['trigger'] := 'include';
Cpp01['body'] := <<BODY
#include <iostream>
BODY;
CppSnippets['INCLUDE'] := Cpp01;

DEF_HASH(Cpp02);
Cpp02['name'] := 'C++ namespace';
Cpp02['trigger'] := 'namespace';
Cpp02['body'] := <<BODY
namespace name {

} // namespace name
BODY;
CppSnippets['NAMESPACE'] := Cpp02;

DEF_HASH(Cpp03);
Cpp03['name'] := 'C++ class';
Cpp03['trigger'] := 'class';
Cpp03['body'] := <<BODY
class Name {
  public:
	Name() = default;
	~Name() = default;
};
BODY;
CppSnippets['CLASS'] := Cpp03;

DEF_HASH(Cpp04);
Cpp04['name'] := 'C++ struct';
Cpp04['trigger'] := 'struct';
Cpp04['body'] := <<BODY
struct Name {
	int value = 0;
};
BODY;
CppSnippets['STRUCT'] := Cpp04;

DEF_HASH(Cpp05);
Cpp05['name'] := 'C++ enum class';
Cpp05['trigger'] := 'enum';
Cpp05['body'] := <<BODY
enum class Name {
	First,
	Second
};
BODY;
CppSnippets['ENUM'] := Cpp05;

DEF_HASH(Cpp06);
Cpp06['name'] := 'C++ main';
Cpp06['trigger'] := 'main';
Cpp06['body'] := <<BODY
int main(int argc, char **argv) {
	return 0;
}
BODY;
CppSnippets['MAIN'] := Cpp06;

DEF_HASH(Cpp07);
Cpp07['name'] := 'C++ function';
Cpp07['trigger'] := 'func';
Cpp07['body'] := <<BODY
int functionName() {
	return 0;
}
BODY;
CppSnippets['FUNCTION'] := Cpp07;

DEF_HASH(Cpp08);
Cpp08['name'] := 'C++ method const';
Cpp08['trigger'] := 'method';
Cpp08['body'] := <<BODY
int value() const noexcept {
	return mValue;
}
BODY;
CppSnippets['METHOD'] := Cpp08;

DEF_HASH(Cpp09);
Cpp09['name'] := 'C++ constructor';
Cpp09['trigger'] := 'ctor';
Cpp09['body'] := <<BODY
Name::Name(int value) : mValue(value) {
}
BODY;
CppSnippets['CTOR'] := Cpp09;

DEF_HASH(Cpp10);
Cpp10['name'] := 'C++ destructor';
Cpp10['trigger'] := 'dtor';
Cpp10['body'] := <<BODY
Name::~Name() {
}
BODY;
CppSnippets['DTOR'] := Cpp10;

DEF_HASH(Cpp11);
Cpp11['name'] := 'C++ if';
Cpp11['trigger'] := 'if';
Cpp11['body'] := <<BODY
if (condition) {
}
BODY;
CppSnippets['IF'] := Cpp11;

DEF_HASH(Cpp12);
Cpp12['name'] := 'C++ else if';
Cpp12['trigger'] := 'elseif';
Cpp12['body'] := <<BODY
else if (condition) {
}
BODY;
CppSnippets['ELSEIF'] := Cpp12;

DEF_HASH(Cpp13);
Cpp13['name'] := 'C++ switch';
Cpp13['trigger'] := 'switch';
Cpp13['body'] := <<BODY
switch (value) {
	case Value:
		break;
	default:
		break;
}
BODY;
CppSnippets['SWITCH'] := Cpp13;

DEF_HASH(Cpp14);
Cpp14['name'] := 'C++ for';
Cpp14['trigger'] := 'for';
Cpp14['body'] := <<BODY
for (int i = 0; i < count; ++i) {
}
BODY;
CppSnippets['FOR'] := Cpp14;

DEF_HASH(Cpp15);
Cpp15['name'] := 'C++ range for';
Cpp15['trigger'] := 'rangefor';
Cpp15['body'] := <<BODY
for (const auto &item : items) {
}
BODY;
CppSnippets['RANGEFOR'] := Cpp15;

DEF_HASH(Cpp16);
Cpp16['name'] := 'C++ while';
Cpp16['trigger'] := 'while';
Cpp16['body'] := <<BODY
while (condition) {
}
BODY;
CppSnippets['WHILE'] := Cpp16;

DEF_HASH(Cpp17);
Cpp17['name'] := 'C++ try catch';
Cpp17['trigger'] := 'try';
Cpp17['body'] := <<BODY
try {
} catch (const std::exception &ex) {
}
BODY;
CppSnippets['TRY'] := Cpp17;

DEF_HASH(Cpp18);
Cpp18['name'] := 'C++ lambda';
Cpp18['trigger'] := 'lambda';
Cpp18['body'] := <<BODY
auto callback = [](const auto &value) {
	return value;
};
BODY;
CppSnippets['LAMBDA'] := Cpp18;

DEF_HASH(Cpp19);
Cpp19['name'] := 'C++ unique ptr';
Cpp19['trigger'] := 'unique';
Cpp19['body'] := <<BODY
std::unique_ptr<Type> value = std::make_unique<Type>();
BODY;
CppSnippets['UNIQUE'] := Cpp19;

DEF_HASH(Cpp20);
Cpp20['name'] := 'C++ shared ptr';
Cpp20['trigger'] := 'shared';
Cpp20['body'] := <<BODY
std::shared_ptr<Type> value = std::make_shared<Type>();
BODY;
CppSnippets['SHARED'] := Cpp20;

DEF_HASH(Cpp21);
Cpp21['name'] := 'C++ vector';
Cpp21['trigger'] := 'vector';
Cpp21['body'] := <<BODY
std::vector<Type> values;
values.push_back(value);
BODY;
CppSnippets['VECTOR'] := Cpp21;

DEF_HASH(Cpp22);
Cpp22['name'] := 'C++ map';
Cpp22['trigger'] := 'map';
Cpp22['body'] := <<BODY
std::map<Key, Value> values;
values[key] = value;
BODY;
CppSnippets['MAP'] := Cpp22;

DEF_HASH(Cpp23);
Cpp23['name'] := 'C++ optional';
Cpp23['trigger'] := 'optional';
Cpp23['body'] := <<BODY
std::optional<Type> value;
if (value.has_value()) {
}
BODY;
CppSnippets['OPTIONAL'] := Cpp23;

DEF_HASH(Cpp24);
Cpp24['name'] := 'C++ assert';
Cpp24['trigger'] := 'assert';
Cpp24['body'] := <<BODY
assert(condition);
BODY;
CppSnippets['ASSERT'] := Cpp24;

DEF_HASH(Cpp25);
Cpp25['name'] := 'C++ static cast';
Cpp25['trigger'] := 'cast';
Cpp25['body'] := <<BODY
auto value = static_cast<Type>(source);
BODY;
CppSnippets['CAST'] := Cpp25;

DEF_HASH(Cpp26);
Cpp26['name'] := 'C++ constexpr';
Cpp26['trigger'] := 'constexpr';
Cpp26['body'] := <<BODY
static constexpr int kValue = 0;
BODY;
CppSnippets['CONSTEXPR'] := Cpp26;

DEF_HASH(Cpp27);
Cpp27['name'] := 'C++ operator';
Cpp27['trigger'] := 'operator';
Cpp27['body'] := <<BODY
bool operator==(const Name &other) const noexcept {
	return mValue == other.mValue;
}
BODY;
CppSnippets['OPERATOR'] := Cpp27;

DEF_HASH(Cpp28);
Cpp28['name'] := 'C++ header guard';
Cpp28['trigger'] := 'guard';
Cpp28['body'] := <<BODY
#ifndef PROJECT_HEADER_HPP
#define PROJECT_HEADER_HPP

#endif
BODY;
CppSnippets['GUARD'] := Cpp28;

DEF_HASH(Cpp29);
Cpp29['name'] := 'C++ ostream';
Cpp29['trigger'] := 'cout';
Cpp29['body'] := <<BODY
std::cout << value << std::endl;
BODY;
CppSnippets['COUT'] := Cpp29;

DEF_HASH(Cpp30);
Cpp30['name'] := 'C++ comment block';
Cpp30['trigger'] := 'comment';
Cpp30['body'] := <<BODY
/*
 * description
 */
BODY;
CppSnippets['COMMENT'] := Cpp30;

Snippets['CPP'] := CppSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'cpp^CPP_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'cpp^CPP_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO CPP_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO CPP_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('CPP');
END_MACRO;
