$MACRO REGISTER_PERL_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, PerlSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Pl01);
Pl01['name'] := 'Perl use strict';
Pl01['trigger'] := 'strict';
Pl01['body'] := <<BODY
use strict;
use warnings;
BODY;
PerlSnippets['STRICT'] := Pl01;

DEF_HASH(Pl02);
Pl02['name'] := 'Perl use module';
Pl02['trigger'] := 'use';
Pl02['body'] := <<BODY
use Module::Name;
BODY;
PerlSnippets['USE'] := Pl02;

DEF_HASH(Pl03);
Pl03['name'] := 'Perl sub';
Pl03['trigger'] := 'sub';
Pl03['body'] := <<BODY
sub name {
    my ($value) = @_;
    return $value;
}
BODY;
PerlSnippets['SUB'] := Pl03;

DEF_HASH(Pl04);
Pl04['name'] := 'Perl main';
Pl04['trigger'] := 'main';
Pl04['body'] := <<BODY
sub main {
    return 0;
}

exit main();
BODY;
PerlSnippets['MAIN'] := Pl04;

DEF_HASH(Pl05);
Pl05['name'] := 'Perl package';
Pl05['trigger'] := 'package';
Pl05['body'] := <<BODY
package Name;

use strict;
use warnings;

1;
BODY;
PerlSnippets['PACKAGE'] := Pl05;

DEF_HASH(Pl06);
Pl06['name'] := 'Perl my';
Pl06['trigger'] := 'my';
Pl06['body'] := <<BODY
my $value = 0;
BODY;
PerlSnippets['MY'] := Pl06;

DEF_HASH(Pl07);
Pl07['name'] := 'Perl array';
Pl07['trigger'] := 'array';
Pl07['body'] := <<BODY
my @values = ();
push @values, $value;
BODY;
PerlSnippets['ARRAY'] := Pl07;

DEF_HASH(Pl08);
Pl08['name'] := 'Perl hash';
Pl08['trigger'] := 'hash';
Pl08['body'] := <<BODY
my %values = ();
$values{$key} = $value;
BODY;
PerlSnippets['HASH'] := Pl08;

DEF_HASH(Pl09);
Pl09['name'] := 'Perl if';
Pl09['trigger'] := 'if';
Pl09['body'] := <<BODY
if ($condition) {
}
BODY;
PerlSnippets['IF'] := Pl09;

DEF_HASH(Pl10);
Pl10['name'] := 'Perl elsif';
Pl10['trigger'] := 'elsif';
Pl10['body'] := <<BODY
elsif ($condition) {
}
BODY;
PerlSnippets['ELSIF'] := Pl10;

DEF_HASH(Pl11);
Pl11['name'] := 'Perl unless';
Pl11['trigger'] := 'unless';
Pl11['body'] := <<BODY
unless ($condition) {
}
BODY;
PerlSnippets['UNLESS'] := Pl11;

DEF_HASH(Pl12);
Pl12['name'] := 'Perl for';
Pl12['trigger'] := 'for';
Pl12['body'] := <<BODY
for (my $i = 0; $i < $count; ++$i) {
}
BODY;
PerlSnippets['FOR'] := Pl12;

DEF_HASH(Pl13);
Pl13['name'] := 'Perl foreach';
Pl13['trigger'] := 'foreach';
Pl13['body'] := <<BODY
foreach my $item (@items) {
}
BODY;
PerlSnippets['FOREACH'] := Pl13;

DEF_HASH(Pl14);
Pl14['name'] := 'Perl while';
Pl14['trigger'] := 'while';
Pl14['body'] := <<BODY
while ($condition) {
}
BODY;
PerlSnippets['WHILE'] := Pl14;

DEF_HASH(Pl15);
Pl15['name'] := 'Perl eval';
Pl15['trigger'] := 'eval';
Pl15['body'] := <<BODY
eval {
    operation();
    1;
} or do {
    my $error = $@ || 'unknown error';
};
BODY;
PerlSnippets['EVAL'] := Pl15;

DEF_HASH(Pl16);
Pl16['name'] := 'Perl open read';
Pl16['trigger'] := 'openread';
Pl16['body'] := <<BODY
open my $fh, '<', $path or die "open $path: $!";
my @lines = <$fh>;
close $fh;
BODY;
PerlSnippets['OPENREAD'] := Pl16;

DEF_HASH(Pl17);
Pl17['name'] := 'Perl open write';
Pl17['trigger'] := 'openwrite';
Pl17['body'] := <<BODY
open my $fh, '>', $path or die "open $path: $!";
print {$fh} $text;
close $fh;
BODY;
PerlSnippets['OPENWRITE'] := Pl17;

DEF_HASH(Pl18);
Pl18['name'] := 'Perl regex match';
Pl18['trigger'] := 'match';
Pl18['body'] := <<BODY
if ($text =~ /pattern/) {
}
BODY;
PerlSnippets['MATCH'] := Pl18;

DEF_HASH(Pl19);
Pl19['name'] := 'Perl regex replace';
Pl19['trigger'] := 'replace';
Pl19['body'] := <<BODY
$text =~ s/pattern/replacement/g;
BODY;
PerlSnippets['REPLACE'] := Pl19;

DEF_HASH(Pl20);
Pl20['name'] := 'Perl map';
Pl20['trigger'] := 'map';
Pl20['body'] := <<BODY
my @values = map { $_->value } @items;
BODY;
PerlSnippets['MAP'] := Pl20;

DEF_HASH(Pl21);
Pl21['name'] := 'Perl grep';
Pl21['trigger'] := 'grep';
Pl21['body'] := <<BODY
my @values = grep { $_->enabled } @items;
BODY;
PerlSnippets['GREP'] := Pl21;

DEF_HASH(Pl22);
Pl22['name'] := 'Perl sort';
Pl22['trigger'] := 'sort';
Pl22['body'] := <<BODY
my @values = sort { $a cmp $b } @items;
BODY;
PerlSnippets['SORT'] := Pl22;

DEF_HASH(Pl23);
Pl23['name'] := 'Perl getopt';
Pl23['trigger'] := 'getopt';
Pl23['body'] := <<BODY
GetOptions(
    'verbose' => \$verbose,
) or die "invalid options\n";
BODY;
PerlSnippets['GETOPT'] := Pl23;

DEF_HASH(Pl24);
Pl24['name'] := 'Perl bless';
Pl24['trigger'] := 'bless';
Pl24['body'] := <<BODY
sub new {
    my ($class, %args) = @_;
    return bless \%args, $class;
}
BODY;
PerlSnippets['BLESS'] := Pl24;

DEF_HASH(Pl25);
Pl25['name'] := 'Perl die';
Pl25['trigger'] := 'die';
Pl25['body'] := <<BODY
die "message\n";
BODY;
PerlSnippets['DIE'] := Pl25;

DEF_HASH(Pl26);
Pl26['name'] := 'Perl warn';
Pl26['trigger'] := 'warn';
Pl26['body'] := <<BODY
warn "message\n";
BODY;
PerlSnippets['WARN'] := Pl26;

DEF_HASH(Pl27);
Pl27['name'] := 'Perl print';
Pl27['trigger'] := 'print';
Pl27['body'] := <<BODY
print "$name: $value\n";
BODY;
PerlSnippets['PRINT'] := Pl27;

DEF_HASH(Pl28);
Pl28['name'] := 'Perl test';
Pl28['trigger'] := 'test';
Pl28['body'] := <<BODY
use Test::More;
is($actual, $expected, 'name');
done_testing();
BODY;
PerlSnippets['TEST'] := Pl28;

DEF_HASH(Pl29);
Pl29['name'] := 'Perl heredoc';
Pl29['trigger'] := 'heredoc';
Pl29['body'] := <<BODY
my $text = <<'TEXT';
content
TEXT
BODY;
PerlSnippets['HEREDOC'] := Pl29;

DEF_HASH(Pl30);
Pl30['name'] := 'Perl comment block';
Pl30['trigger'] := 'comment';
Pl30['body'] := <<BODY
=pod

description

=cut
BODY;
PerlSnippets['COMMENT'] := Pl30;

Snippets['PERL'] := PerlSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'perl^PERL_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'perl^PERL_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO PERL_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO PERL_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('PERL');
END_MACRO;
