$MACRO REGISTER_MARKDOWN_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, MdSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Md01);
Md01['name'] := 'Markdown heading 1';
Md01['trigger'] := 'h1';
Md01['body'] := <<BODY
# Heading
BODY;
MdSnippets['H1'] := Md01;

DEF_HASH(Md02);
Md02['name'] := 'Markdown heading 2';
Md02['trigger'] := 'h2';
Md02['body'] := <<BODY
## Heading
BODY;
MdSnippets['H2'] := Md02;

DEF_HASH(Md03);
Md03['name'] := 'Markdown heading 3';
Md03['trigger'] := 'h3';
Md03['body'] := <<BODY
### Heading
BODY;
MdSnippets['H3'] := Md03;

DEF_HASH(Md04);
Md04['name'] := 'Markdown paragraph';
Md04['trigger'] := 'p';
Md04['body'] := <<BODY
Paragraph text.
BODY;
MdSnippets['P'] := Md04;

DEF_HASH(Md05);
Md05['name'] := 'Markdown bold';
Md05['trigger'] := 'bold';
Md05['body'] := <<BODY
**strong text**
BODY;
MdSnippets['BOLD'] := Md05;

DEF_HASH(Md06);
Md06['name'] := 'Markdown italic';
Md06['trigger'] := 'italic';
Md06['body'] := <<BODY
*emphasized text*
BODY;
MdSnippets['ITALIC'] := Md06;

DEF_HASH(Md07);
Md07['name'] := 'Markdown code';
Md07['trigger'] := 'code';
Md07['body'] := <<BODY
`code`
BODY;
MdSnippets['CODE'] := Md07;

DEF_HASH(Md08);
Md08['name'] := 'Markdown fenced code';
Md08['trigger'] := 'fence';
Md08['body'] := <<BODY
```text
content
```
BODY;
MdSnippets['FENCE'] := Md08;

DEF_HASH(Md09);
Md09['name'] := 'Markdown blockquote';
Md09['trigger'] := 'quote';
Md09['body'] := <<BODY
> Quote text.
BODY;
MdSnippets['QUOTE'] := Md09;

DEF_HASH(Md10);
Md10['name'] := 'Markdown unordered list';
Md10['trigger'] := 'ul';
Md10['body'] := <<BODY
- Item
- Item
BODY;
MdSnippets['UL'] := Md10;

DEF_HASH(Md11);
Md11['name'] := 'Markdown ordered list';
Md11['trigger'] := 'ol';
Md11['body'] := <<BODY
1. Item
2. Item
BODY;
MdSnippets['OL'] := Md11;

DEF_HASH(Md12);
Md12['name'] := 'Markdown task list';
Md12['trigger'] := 'task';
Md12['body'] := <<BODY
- [ ] Task
- [x] Done
BODY;
MdSnippets['TASK'] := Md12;

DEF_HASH(Md13);
Md13['name'] := 'Markdown link';
Md13['trigger'] := 'link';
Md13['body'] := <<BODY
[label](https://example.com)
BODY;
MdSnippets['LINK'] := Md13;

DEF_HASH(Md14);
Md14['name'] := 'Markdown image';
Md14['trigger'] := 'image';
Md14['body'] := <<BODY
![alt text](image.png)
BODY;
MdSnippets['IMAGE'] := Md14;

DEF_HASH(Md15);
Md15['name'] := 'Markdown table';
Md15['trigger'] := 'table';
Md15['body'] := <<BODY
| Column | Column |
| ------ | ------ |
| Value  | Value  |
BODY;
MdSnippets['TABLE'] := Md15;

DEF_HASH(Md16);
Md16['name'] := 'Markdown horizontal rule';
Md16['trigger'] := 'hr';
Md16['body'] := <<BODY
---
BODY;
MdSnippets['HR'] := Md16;

DEF_HASH(Md17);
Md17['name'] := 'Markdown front matter';
Md17['trigger'] := 'front';
Md17['body'] := <<BODY
---
title: Title
date: 2026-05-23
---
BODY;
MdSnippets['FRONT'] := Md17;

DEF_HASH(Md18);
Md18['name'] := 'Markdown footnote';
Md18['trigger'] := 'footnote';
Md18['body'] := <<BODY
Text with footnote.[^1]

[^1]: Footnote text.
BODY;
MdSnippets['FOOTNOTE'] := Md18;

DEF_HASH(Md19);
Md19['name'] := 'Markdown definition list';
Md19['trigger'] := 'deflist';
Md19['body'] := <<BODY
Term
: Definition
BODY;
MdSnippets['DEFLIST'] := Md19;

DEF_HASH(Md20);
Md20['name'] := 'Markdown admonition';
Md20['trigger'] := 'note';
Md20['body'] := <<BODY
> [!NOTE]
> Note text.
BODY;
MdSnippets['NOTE'] := Md20;

DEF_HASH(Md21);
Md21['name'] := 'Markdown warning';
Md21['trigger'] := 'warning';
Md21['body'] := <<BODY
> [!WARNING]
> Warning text.
BODY;
MdSnippets['WARNING'] := Md21;

DEF_HASH(Md22);
Md22['name'] := 'Markdown details';
Md22['trigger'] := 'details';
Md22['body'] := <<BODY
<details>
<summary>Summary</summary>

Content.

</details>
BODY;
MdSnippets['DETAILS'] := Md22;

DEF_HASH(Md23);
Md23['name'] := 'Markdown anchor';
Md23['trigger'] := 'anchor';
Md23['body'] := <<BODY
<a id="anchor-name"></a>
BODY;
MdSnippets['ANCHOR'] := Md23;

DEF_HASH(Md24);
Md24['name'] := 'Markdown badge';
Md24['trigger'] := 'badge';
Md24['body'] := <<BODY
![status](https://img.shields.io/badge/status-ok-green)
BODY;
MdSnippets['BADGE'] := Md24;

DEF_HASH(Md25);
Md25['name'] := 'Markdown API section';
Md25['trigger'] := 'api';
Md25['body'] := <<BODY
## API

### `name`

Description.
BODY;
MdSnippets['API'] := Md25;

DEF_HASH(Md26);
Md26['name'] := 'Markdown changelog entry';
Md26['trigger'] := 'change';
Md26['body'] := <<BODY
## Unreleased

- Added:
- Changed:
- Fixed:
BODY;
MdSnippets['CHANGE'] := Md26;

DEF_HASH(Md27);
Md27['name'] := 'Markdown decision';
Md27['trigger'] := 'decision';
Md27['body'] := <<BODY
## Decision

Context:

Decision:

Consequences:
BODY;
MdSnippets['DECISION'] := Md27;

DEF_HASH(Md28);
Md28['name'] := 'Markdown checklist';
Md28['trigger'] := 'checklist';
Md28['body'] := <<BODY
## Checklist

- [ ] Item
- [ ] Item
BODY;
MdSnippets['CHECKLIST'] := Md28;

DEF_HASH(Md29);
Md29['name'] := 'Markdown callout';
Md29['trigger'] := 'callout';
Md29['body'] := <<BODY
> Important:
> Text.
BODY;
MdSnippets['CALLOUT'] := Md29;

DEF_HASH(Md30);
Md30['name'] := 'Markdown comment';
Md30['trigger'] := 'comment';
Md30['body'] := <<BODY
<!-- description -->
BODY;
MdSnippets['COMMENT'] := Md30;

Snippets['MARKDOWN'] := MdSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'markdown^MARKDOWN_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'markdown^MARKDOWN_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO MARKDOWN_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO MARKDOWN_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('MARKDOWN');
END_MACRO;
