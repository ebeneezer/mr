$MACRO REGISTER_BASH_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, BashSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Sh01);
Sh01['name'] := 'Bash shebang';
Sh01['trigger'] := 'shebang';
Sh01['body'] := <<BODY
#!/usr/bin/env bash
set -euo pipefail
BODY;
BashSnippets['SHEBANG'] := Sh01;

DEF_HASH(Sh02);
Sh02['name'] := 'Bash strict mode';
Sh02['trigger'] := 'strict';
Sh02['body'] := <<BODY
set -euo pipefail
IFS=$'\n\t'
BODY;
BashSnippets['STRICT'] := Sh02;

DEF_HASH(Sh03);
Sh03['name'] := 'Bash function';
Sh03['trigger'] := 'function';
Sh03['body'] := <<BODY
function name() {
    local value="$1"
}
BODY;
BashSnippets['FUNCTION'] := Sh03;

DEF_HASH(Sh04);
Sh04['name'] := 'Bash main';
Sh04['trigger'] := 'main';
Sh04['body'] := <<BODY
function main() {
    return 0
}

main "$@"
BODY;
BashSnippets['MAIN'] := Sh04;

DEF_HASH(Sh05);
Sh05['name'] := 'Bash local';
Sh05['trigger'] := 'local';
Sh05['body'] := <<BODY
local value="${1:-default}"
BODY;
BashSnippets['LOCAL'] := Sh05;

DEF_HASH(Sh06);
Sh06['name'] := 'Bash if';
Sh06['trigger'] := 'if';
Sh06['body'] := <<BODY
if [[ condition ]]; then
fi
BODY;
BashSnippets['IF'] := Sh06;

DEF_HASH(Sh07);
Sh07['name'] := 'Bash file exists';
Sh07['trigger'] := 'exists';
Sh07['body'] := <<BODY
if [[ -f "$path" ]]; then
fi
BODY;
BashSnippets['EXISTS'] := Sh07;

DEF_HASH(Sh08);
Sh08['name'] := 'Bash directory';
Sh08['trigger'] := 'dir';
Sh08['body'] := <<BODY
if [[ -d "$dir" ]]; then
fi
BODY;
BashSnippets['DIR'] := Sh08;

DEF_HASH(Sh09);
Sh09['name'] := 'Bash case';
Sh09['trigger'] := 'case';
Sh09['body'] := <<BODY
case "$value" in
    pattern)
        ;;
    *)
        ;;
esac
BODY;
BashSnippets['CASE'] := Sh09;

DEF_HASH(Sh10);
Sh10['name'] := 'Bash for';
Sh10['trigger'] := 'for';
Sh10['body'] := <<BODY
for item in "${items[@]}"; do
done
BODY;
BashSnippets['FOR'] := Sh10;

DEF_HASH(Sh11);
Sh11['name'] := 'Bash while';
Sh11['trigger'] := 'while';
Sh11['body'] := <<BODY
while [[ condition ]]; do
done
BODY;
BashSnippets['WHILE'] := Sh11;

DEF_HASH(Sh12);
Sh12['name'] := 'Bash read loop';
Sh12['trigger'] := 'readloop';
Sh12['body'] := <<BODY
while IFS= read -r line; do
done < "$file"
BODY;
BashSnippets['READLOOP'] := Sh12;

DEF_HASH(Sh13);
Sh13['name'] := 'Bash until';
Sh13['trigger'] := 'until';
Sh13['body'] := <<BODY
until [[ condition ]]; do
done
BODY;
BashSnippets['UNTIL'] := Sh13;

DEF_HASH(Sh14);
Sh14['name'] := 'Bash array';
Sh14['trigger'] := 'array';
Sh14['body'] := <<BODY
items=()
items+=("$value")
BODY;
BashSnippets['ARRAY'] := Sh14;

DEF_HASH(Sh15);
Sh15['name'] := 'Bash associative array';
Sh15['trigger'] := 'assoc';
Sh15['body'] := <<BODY
declare -A values=()
values["$key"]="$value"
BODY;
BashSnippets['ASSOC'] := Sh15;

DEF_HASH(Sh16);
Sh16['name'] := 'Bash getopts';
Sh16['trigger'] := 'getopts';
Sh16['body'] := <<BODY
while getopts ":hv" opt; do
    case "$opt" in
        h) usage ;;
        v) verbose=1 ;;
    esac
done
BODY;
BashSnippets['GETOPTS'] := Sh16;

DEF_HASH(Sh17);
Sh17['name'] := 'Bash usage';
Sh17['trigger'] := 'usage';
Sh17['body'] := <<BODY
function usage() {
    printf 'usage: %s [options]\n' "${0##*/}"
}
BODY;
BashSnippets['USAGE'] := Sh17;

DEF_HASH(Sh18);
Sh18['name'] := 'Bash trap';
Sh18['trigger'] := 'trap';
Sh18['body'] := <<BODY
trap 'cleanup' EXIT
BODY;
BashSnippets['TRAP'] := Sh18;

DEF_HASH(Sh19);
Sh19['name'] := 'Bash cleanup';
Sh19['trigger'] := 'cleanup';
Sh19['body'] := <<BODY
function cleanup() {
    rm -f "$tmp"
}
BODY;
BashSnippets['CLEANUP'] := Sh19;

DEF_HASH(Sh20);
Sh20['name'] := 'Bash tempdir';
Sh20['trigger'] := 'tempdir';
Sh20['body'] := <<BODY
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
BODY;
BashSnippets['TEMPDIR'] := Sh20;

DEF_HASH(Sh21);
Sh21['name'] := 'Bash command check';
Sh21['trigger'] := 'command';
Sh21['body'] := <<BODY
if ! command -v tool >/dev/null 2>&1; then
    printf 'missing tool: %s\n' tool >&2
    exit 1
fi
BODY;
BashSnippets['COMMAND'] := Sh21;

DEF_HASH(Sh22);
Sh22['name'] := 'Bash here doc';
Sh22['trigger'] := 'heredoc';
Sh22['body'] := <<BODY
cat <<'TEXT'
content
TEXT
BODY;
BashSnippets['HEREDOC'] := Sh22;

DEF_HASH(Sh23);
Sh23['name'] := 'Bash subshell';
Sh23['trigger'] := 'subshell';
Sh23['body'] := <<BODY
(
    cd "$dir"
    command
)
BODY;
BashSnippets['SUBSHELL'] := Sh23;

DEF_HASH(Sh24);
Sh24['name'] := 'Bash pipe';
Sh24['trigger'] := 'pipe';
Sh24['body'] := <<BODY
command_one | command_two
BODY;
BashSnippets['PIPE'] := Sh24;

DEF_HASH(Sh25);
Sh25['name'] := 'Bash redirect';
Sh25['trigger'] := 'redirect';
Sh25['body'] := <<BODY
command >"$output" 2>"$error_log"
BODY;
BashSnippets['REDIRECT'] := Sh25;

DEF_HASH(Sh26);
Sh26['name'] := 'Bash parameter default';
Sh26['trigger'] := 'default';
Sh26['body'] := <<BODY
value="${name:-default}"
BODY;
BashSnippets['DEFAULT'] := Sh26;

DEF_HASH(Sh27);
Sh27['name'] := 'Bash parameter require';
Sh27['trigger'] := 'require';
Sh27['body'] := <<BODY
value="${name:?name is required}"
BODY;
BashSnippets['REQUIRE'] := Sh27;

DEF_HASH(Sh28);
Sh28['name'] := 'Bash arithmetic';
Sh28['trigger'] := 'arith';
Sh28['body'] := <<BODY
count=$((count + 1))
BODY;
BashSnippets['ARITH'] := Sh28;

DEF_HASH(Sh29);
Sh29['name'] := 'Bash log';
Sh29['trigger'] := 'log';
Sh29['body'] := <<BODY
printf '%s\n' "$message" >&2
BODY;
BashSnippets['LOG'] := Sh29;

DEF_HASH(Sh30);
Sh30['name'] := 'Bash comment block';
Sh30['trigger'] := 'comment';
Sh30['body'] := <<BODY
# -----------------------------------------------------------------------------
# description
# -----------------------------------------------------------------------------
BODY;
BashSnippets['COMMENT'] := Sh30;

Snippets['BASH'] := BashSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'bash^BASH_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'bash^BASH_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO BASH_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO BASH_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('BASH');
END_MACRO;
