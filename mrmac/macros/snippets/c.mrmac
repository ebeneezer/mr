$MACRO C_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO C_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('C');
END_MACRO;
