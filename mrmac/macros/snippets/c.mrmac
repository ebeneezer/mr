$MACRO REGISTER_C_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, CSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(ForSnippet, ForPlaceholders, ForPlaceholder1, ForPlaceholder2, ForPlaceholder3, ForPlaceholder4);
ForPlaceholder1['default'] := 'int i = 0';
ForPlaceholder1['hint'] := 'Loop initializer';
ForPlaceholder2['default'] := 'i < limit';
ForPlaceholder2['hint'] := 'Loop condition';
ForPlaceholder3['default'] := '++i';
ForPlaceholder3['hint'] := 'Loop increment';
ForPlaceholder4['default'] := '/* body */';
ForPlaceholder4['hint'] := 'Loop body';
ForPlaceholders['1'] := ForPlaceholder1;
ForPlaceholders['2'] := ForPlaceholder2;
ForPlaceholders['3'] := ForPlaceholder3;
ForPlaceholders['4'] := ForPlaceholder4;
ForSnippet['name'] := 'C for';
ForSnippet['trigger'] := 'for';
ForSnippet['body'] := <<BODY
for (//1; //2; //3) {
    //4
}
BODY;
ForSnippet['placeholders'] := ForPlaceholders;
CSnippets['FOR'] := ForSnippet;

