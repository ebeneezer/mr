MACRO_TO_KEY('<Ctrl+Space>', 'c^C_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'c^C_SNIPPET_EXPAND_KEYWORD', 0);
