$MACRO REGISTER_MRMAC_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, MrmacSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Mr01);
Mr01['name'] := 'MRMAC macro';
Mr01['trigger'] := 'macro';
Mr01['body'] := <<BODY
$MACRO NAME FROM EDIT;
END_MACRO;
BODY;
MrmacSnippets['MACRO'] := Mr01;

DEF_HASH(Mr02);
Mr02['name'] := 'MRMAC startup macro';
Mr02['trigger'] := 'startup';
Mr02['body'] := <<BODY
$MACRO NAME FROM STARTUP;
END_MACRO;
BODY;
MrmacSnippets['STARTUP'] := Mr02;

DEF_HASH(Mr03);
Mr03['name'] := 'MRMAC int declaration';
Mr03['trigger'] := 'defint';
Mr03['body'] := <<BODY
DEF_INT(value);
BODY;
MrmacSnippets['DEFINT'] := Mr03;

DEF_HASH(Mr04);
Mr04['name'] := 'MRMAC string declaration';
Mr04['trigger'] := 'defstr';
Mr04['body'] := <<BODY
DEF_STR(text);
BODY;
MrmacSnippets['DEFSTR'] := Mr04;

DEF_HASH(Mr05);
Mr05['name'] := 'MRMAC hash declaration';
Mr05['trigger'] := 'defhash';
Mr05['body'] := <<BODY
DEF_HASH(values);
BODY;
MrmacSnippets['DEFHASH'] := Mr05;

DEF_HASH(Mr06);
Mr06['name'] := 'MRMAC array declaration';
Mr06['trigger'] := 'defarray';
Mr06['body'] := <<BODY
DEF_INT(values[]);
BODY;
MrmacSnippets['DEFARRAY'] := Mr06;

DEF_HASH(Mr07);
Mr07['name'] := 'MRMAC assignment';
Mr07['trigger'] := 'assign';
Mr07['body'] := <<BODY
value := 0;
BODY;
MrmacSnippets['ASSIGN'] := Mr07;

DEF_HASH(Mr08);
Mr08['name'] := 'MRMAC if';
Mr08['trigger'] := 'if';
Mr08['body'] := <<BODY
IF value THEN
ENDIF;
BODY;
MrmacSnippets['IF'] := Mr08;

DEF_HASH(Mr09);
Mr09['name'] := 'MRMAC if else';
Mr09['trigger'] := 'ifelse';
Mr09['body'] := <<BODY
IF value THEN
ELSE
ENDIF;
BODY;
MrmacSnippets['IFELSE'] := Mr09;

DEF_HASH(Mr10);
Mr10['name'] := 'MRMAC while';
Mr10['trigger'] := 'while';
Mr10['body'] := <<BODY
WHILE value DO
ENDWHILE;
BODY;
MrmacSnippets['WHILE'] := Mr10;

DEF_HASH(Mr11);
Mr11['name'] := 'MRMAC repeat';
Mr11['trigger'] := 'repeat';
Mr11['body'] := <<BODY
REPEAT
UNTIL value;
BODY;
MrmacSnippets['REPEAT'] := Mr11;

DEF_HASH(Mr12);
Mr12['name'] := 'MRMAC hash write';
Mr12['trigger'] := 'hashwrite';
Mr12['body'] := <<BODY
values['KEY'] := value;
BODY;
MrmacSnippets['HASHWRITE'] := Mr12;

DEF_HASH(Mr13);
Mr13['name'] := 'MRMAC hash read';
Mr13['trigger'] := 'hashread';
Mr13['body'] := <<BODY
value := values['KEY'];
BODY;
MrmacSnippets['HASHREAD'] := Mr13;

DEF_HASH(Mr14);
Mr14['name'] := 'MRMAC global hash';
Mr14['trigger'] := 'globalhash';
Mr14['body'] := <<BODY
values := GLOBAL_HASH('NAME');
BODY;
MrmacSnippets['GLOBALHASH'] := Mr14;

DEF_HASH(Mr15);
Mr15['name'] := 'MRMAC set global hash';
Mr15['trigger'] := 'setglobalhash';
Mr15['body'] := <<BODY
SET_GLOBAL_HASH('NAME', values);
BODY;
MrmacSnippets['SETGLOBALHASH'] := Mr15;

DEF_HASH(Mr16);
Mr16['name'] := 'MRMAC exists';
Mr16['trigger'] := 'exists';
Mr16['body'] := <<BODY
IF EXISTS(values, 'KEY') THEN
ENDIF;
BODY;
MrmacSnippets['EXISTS'] := Mr16;

DEF_HASH(Mr17);
Mr17['name'] := 'MRMAC keys';
Mr17['trigger'] := 'keys';
Mr17['body'] := <<BODY
keys := KEYS(values);
BODY;
MrmacSnippets['KEYS'] := Mr17;

DEF_HASH(Mr18);
Mr18['name'] := 'MRMAC values';
Mr18['trigger'] := 'values';
Mr18['body'] := <<BODY
items := VALUES(values);
BODY;
MrmacSnippets['VALUES'] := Mr18;

DEF_HASH(Mr19);
Mr19['name'] := 'MRMAC len';
Mr19['trigger'] := 'len';
Mr19['body'] := <<BODY
count := LEN(values);
BODY;
MrmacSnippets['LEN'] := Mr19;

DEF_HASH(Mr20);
Mr20['name'] := 'MRMAC macro key';
Mr20['trigger'] := 'key';
Mr20['body'] := <<BODY
MACRO_TO_KEY('<Ctrl+K>', 'file^MACRO_NAME', 0);
BODY;
MrmacSnippets['KEY'] := Mr20;

DEF_HASH(Mr21);
Mr21['name'] := 'MRMAC snippet start';
Mr21['trigger'] := 'snippetstart';
Mr21['body'] := <<BODY
SNIPPET_START();
BODY;
MrmacSnippets['SNIPPETSTART'] := Mr21;

DEF_HASH(Mr22);
Mr22['name'] := 'MRMAC snippet unload';
Mr22['trigger'] := 'snippetunload';
Mr22['body'] := <<BODY
SNIPPETS_UNLOAD('MRMAC');
BODY;
MrmacSnippets['SNIPPETUNLOAD'] := Mr22;

DEF_HASH(Mr23);
Mr23['name'] := 'MRMAC message';
Mr23['trigger'] := 'message';
Mr23['body'] := <<BODY
MAKE_MESSAGE('message');
BODY;
MrmacSnippets['MESSAGE'] := Mr23;

DEF_HASH(Mr24);
Mr24['name'] := 'MRMAC insert text';
Mr24['trigger'] := 'insert';
Mr24['body'] := <<BODY
INSERT_TEXT('text');
BODY;
MrmacSnippets['INSERT'] := Mr24;

DEF_HASH(Mr25);
Mr25['name'] := 'MRMAC get line';
Mr25['trigger'] := 'getline';
Mr25['body'] := <<BODY
text := GET_LINE();
BODY;
MrmacSnippets['GETLINE'] := Mr25;

DEF_HASH(Mr26);
Mr26['name'] := 'MRMAC cursor';
Mr26['trigger'] := 'cursor';
Mr26['body'] := <<BODY
RIGHT();
LEFT();
BODY;
MrmacSnippets['CURSOR'] := Mr26;

DEF_HASH(Mr27);
Mr27['name'] := 'MRMAC heredoc';
Mr27['trigger'] := 'heredoc';
Mr27['body'] := <<BODY
text := <<TEXT
content
TEXT;
BODY;
MrmacSnippets['HEREDOC'] := Mr27;

DEF_HASH(Mr28);
Mr28['name'] := 'MRMAC load macro';
Mr28['trigger'] := 'loadmacro';
Mr28['body'] := <<BODY
LOAD_MACRO_FILE('file.mrmac');
BODY;
MrmacSnippets['LOADMACRO'] := Mr28;

DEF_HASH(Mr29);
Mr29['name'] := 'MRMAC run macro';
Mr29['trigger'] := 'runmacro';
Mr29['body'] := <<BODY
RUN_MACRO('file^MACRO_NAME');
BODY;
MrmacSnippets['RUNMACRO'] := Mr29;

DEF_HASH(Mr30);
Mr30['name'] := 'MRMAC comment block';
Mr30['trigger'] := 'comment';
Mr30['body'] := <<BODY
/* description */
BODY;
MrmacSnippets['COMMENT'] := Mr30;

Snippets['MRMAC'] := MrmacSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'mrmac^MRMAC_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'mrmac^MRMAC_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO MRMAC_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO MRMAC_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('MRMAC');
END_MACRO;
