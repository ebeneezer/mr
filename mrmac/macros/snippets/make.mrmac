$MACRO REGISTER_MAKE_SNIPPETS FROM EDIT;
DEF_HASH(Snippets, MakeSnippets);

Snippets := GLOBAL_HASH('SNIPPETS');

DEF_HASH(Mk01);
Mk01['name'] := 'Make phony';
Mk01['trigger'] := 'phony';
Mk01['body'] := <<BODY
.PHONY: target
target:
	@echo "target"
BODY;
MakeSnippets['PHONY'] := Mk01;

DEF_HASH(Mk02);
Mk02['name'] := 'Make variable';
Mk02['trigger'] := 'var';
Mk02['body'] := <<BODY
NAME := value
BODY;
MakeSnippets['VAR'] := Mk02;

DEF_HASH(Mk03);
Mk03['name'] := 'Make default goal';
Mk03['trigger'] := 'default';
Mk03['body'] := <<BODY
.DEFAULT_GOAL := all
BODY;
MakeSnippets['DEFAULT'] := Mk03;

DEF_HASH(Mk04);
Mk04['name'] := 'Make all target';
Mk04['trigger'] := 'all';
Mk04['body'] := <<BODY
.PHONY: all
all: build
BODY;
MakeSnippets['ALL'] := Mk04;

DEF_HASH(Mk05);
Mk05['name'] := 'Make clean';
Mk05['trigger'] := 'clean';
Mk05['body'] := <<BODY
.PHONY: clean
clean:
	rm -f $(OBJECTS)
BODY;
MakeSnippets['CLEAN'] := Mk05;

DEF_HASH(Mk06);
Mk06['name'] := 'Make install';
Mk06['trigger'] := 'install';
Mk06['body'] := <<BODY
.PHONY: install
install:
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 program $(DESTDIR)$(PREFIX)/bin/program
BODY;
MakeSnippets['INSTALL'] := Mk06;

DEF_HASH(Mk07);
Mk07['name'] := 'Make uninstall';
Mk07['trigger'] := 'uninstall';
Mk07['body'] := <<BODY
.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/program
BODY;
MakeSnippets['UNINSTALL'] := Mk07;

DEF_HASH(Mk08);
Mk08['name'] := 'Make object rule';
Mk08['trigger'] := 'object';
Mk08['body'] := <<BODY
%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
BODY;
MakeSnippets['OBJECT'] := Mk08;

DEF_HASH(Mk09);
Mk09['name'] := 'Make link rule';
Mk09['trigger'] := 'link';
Mk09['body'] := <<BODY
program: $(OBJECTS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)
BODY;
MakeSnippets['LINK'] := Mk09;

DEF_HASH(Mk10);
Mk10['name'] := 'Make dependency include';
Mk10['trigger'] := 'deps';
Mk10['body'] := <<BODY
-include $(OBJECTS:.o=.d)
BODY;
MakeSnippets['DEPS'] := Mk10;

DEF_HASH(Mk11);
Mk11['name'] := 'Make compile deps';
Mk11['trigger'] := 'compiledeps';
Mk11['body'] := <<BODY
%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
BODY;
MakeSnippets['COMPILEDEPS'] := Mk11;

DEF_HASH(Mk12);
Mk12['name'] := 'Make wildcard';
Mk12['trigger'] := 'wildcard';
Mk12['body'] := <<BODY
SOURCES := $(wildcard src/*.cpp)
OBJECTS := $(SOURCES:.cpp=.o)
BODY;
MakeSnippets['WILDCARD'] := Mk12;

DEF_HASH(Mk13);
Mk13['name'] := 'Make patsubst';
Mk13['trigger'] := 'patsubst';
Mk13['body'] := <<BODY
OBJECTS := $(patsubst %.cpp,%.o,$(SOURCES))
BODY;
MakeSnippets['PATSUBST'] := Mk13;

DEF_HASH(Mk14);
Mk14['name'] := 'Make foreach';
Mk14['trigger'] := 'foreach';
Mk14['body'] := <<BODY
NAMES := $(foreach item,$(ITEMS),$(item).o)
BODY;
MakeSnippets['FOREACH'] := Mk14;

DEF_HASH(Mk15);
Mk15['name'] := 'Make ifeq';
Mk15['trigger'] := 'ifeq';
Mk15['body'] := <<BODY
ifeq ($(MODE),debug)
CXXFLAGS += -g -O0
endif
BODY;
MakeSnippets['IFEQ'] := Mk15;

DEF_HASH(Mk16);
Mk16['name'] := 'Make ifneq';
Mk16['trigger'] := 'ifneq';
Mk16['body'] := <<BODY
ifneq ($(strip $(VALUE)),)
$(info VALUE=$(VALUE))
endif
BODY;
MakeSnippets['IFNEQ'] := Mk16;

DEF_HASH(Mk17);
Mk17['name'] := 'Make shell';
Mk17['trigger'] := 'shell';
Mk17['body'] := <<BODY
VERSION := $(shell git describe --always --dirty)
BODY;
MakeSnippets['SHELL'] := Mk17;

DEF_HASH(Mk18);
Mk18['name'] := 'Make export';
Mk18['trigger'] := 'export';
Mk18['body'] := <<BODY
export NAME := value
BODY;
MakeSnippets['EXPORT'] := Mk18;

DEF_HASH(Mk19);
Mk19['name'] := 'Make override';
Mk19['trigger'] := 'override';
Mk19['body'] := <<BODY
override CXXFLAGS += -Wall
BODY;
MakeSnippets['OVERRIDE'] := Mk19;

DEF_HASH(Mk20);
Mk20['name'] := 'Make define';
Mk20['trigger'] := 'define';
Mk20['body'] := <<BODY
define MESSAGE
line one
line two
endef
BODY;
MakeSnippets['DEFINE'] := Mk20;

DEF_HASH(Mk21);
Mk21['name'] := 'Make call';
Mk21['trigger'] := 'call';
Mk21['body'] := <<BODY
define run
	@echo $(1)
endef
BODY;
MakeSnippets['CALL'] := Mk21;

DEF_HASH(Mk22);
Mk22['name'] := 'Make order only';
Mk22['trigger'] := 'order';
Mk22['body'] := <<BODY
target: prerequisite | directory
	@echo "$@"
BODY;
MakeSnippets['ORDER'] := Mk22;

DEF_HASH(Mk23);
Mk23['name'] := 'Make directory';
Mk23['trigger'] := 'dir';
Mk23['body'] := <<BODY
directory:
	mkdir -p $@
BODY;
MakeSnippets['DIR'] := Mk23;

DEF_HASH(Mk24);
Mk24['name'] := 'Make test';
Mk24['trigger'] := 'test';
Mk24['body'] := <<BODY
.PHONY: test
test: program
	./program --test
BODY;
MakeSnippets['TEST'] := Mk24;

DEF_HASH(Mk25);
Mk25['name'] := 'Make check';
Mk25['trigger'] := 'check';
Mk25['body'] := <<BODY
.PHONY: check
check:
	$(MAKE) test
BODY;
MakeSnippets['CHECK'] := Mk25;

DEF_HASH(Mk26);
Mk26['name'] := 'Make dist';
Mk26['trigger'] := 'dist';
Mk26['body'] := <<BODY
.PHONY: dist
dist:
	tar -czf project.tar.gz $(SOURCES)
BODY;
MakeSnippets['DIST'] := Mk26;

DEF_HASH(Mk27);
Mk27['name'] := 'Make help';
Mk27['trigger'] := 'help';
Mk27['body'] := <<BODY
.PHONY: help
help:
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST)
BODY;
MakeSnippets['HELP'] := Mk27;

DEF_HASH(Mk28);
Mk28['name'] := 'Make recipe echo';
Mk28['trigger'] := 'echo';
Mk28['body'] := <<BODY
target:
	@printf '%s\n' "message"
BODY;
MakeSnippets['ECHO'] := Mk28;

DEF_HASH(Mk29);
Mk29['name'] := 'Make recursive';
Mk29['trigger'] := 'recursive';
Mk29['body'] := <<BODY
.PHONY: subdir
subdir:
	$(MAKE) -C subdir all
BODY;
MakeSnippets['RECURSIVE'] := Mk29;

DEF_HASH(Mk30);
Mk30['name'] := 'Make comment block';
Mk30['trigger'] := 'comment';
Mk30['body'] := <<BODY
###############################################################################
# description
###############################################################################
BODY;
MakeSnippets['COMMENT'] := Mk30;

Snippets['MAKE'] := MakeSnippets;
SET_GLOBAL_HASH('SNIPPETS', Snippets);

MACRO_TO_KEY('<Ctrl+Space>', 'make^MAKE_SNIPPET_EXPAND_KEYWORD', 0);
MACRO_TO_KEY('<Ctrl+@>', 'make^MAKE_SNIPPET_EXPAND_KEYWORD', 0);
END_MACRO;

$MACRO MAKE_SNIPPET_EXPAND_KEYWORD FROM EDIT;
SNIPPET_START();
END_MACRO;

$MACRO MAKE_SNIPPETS_UNLOAD FROM EDIT;
SNIPPETS_UNLOAD('MAKE');
END_MACRO;
