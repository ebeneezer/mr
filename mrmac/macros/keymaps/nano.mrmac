$MACRO MR_KEYMAP FROM EDIT;
KEYMAP_RESET();
KEYMAP_VERSION('1778962202');
KEYMAP_PROFILE('name="NANO" description="GNU nano core"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_UP" sequence="<Ctrl+P>" description="Previous line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_DOWN" sequence="<Ctrl+N>" description="Next line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_LEFT" sequence="<Ctrl+B>" description="Backward"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_RIGHT" sequence="<Ctrl+F>" description="Forward"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MR_BLOCK_MARK_ALL" sequence="<Ctrl+A>" description="Mark all as line block"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_END_OF_LINE" sequence="<Ctrl+E>" description="End of line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_VIEW_PAGE_UP" sequence="<Ctrl+Y>" description="Page up"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_VIEW_PAGE_DOWN" sequence="<Ctrl+V>" description="Page down"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_TOP_OF_FILE" sequence="<Alt+Home>" description="First line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_BOTTOM_OF_FILE" sequence="<Alt+End>" description="Last line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_CURSOR_GOTO_LINE" sequence="<Alt+G>" description="Goto line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_SEARCH_FORWARD" sequence="<Ctrl+W>" description="Where is"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_SEARCH_REPLACE" sequence="<Alt+R>" description="Replace"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_DELETE_LINE" sequence="<Ctrl+K>" description="Cut line"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_BLOCK_SET_BEGIN" sequence="<Alt+A>" description="Set mark"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_BLOCK_CLEAR" sequence="<Ctrl+G>" description="Cancel mark"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_BLOCK_PASTE_FROM_CLIPBOARD" sequence="<Ctrl+U>" description="Paste from clipboard"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_UNDO" sequence="<Alt+U>" description="Undo"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_REDO_LAST_UNDO" sequence="<Alt+E>" description="Redo"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MR_TEXT_REFORMAT_PARAGRAPH" sequence="<Alt+J>" description="Justify paragraph"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MRMAC_FILE_SAVE" sequence="<Ctrl+O>" description="Write out"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MR_BUILD_CURRENT_FILE" sequence="<F9>" description="Build current file"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MR_MATCH_PARENTHESIS" sequence="<Alt+P>" description="Match parenthesis"');
KEYMAP_BIND('name="NANO" context=EDIT type=ACTION target="MR_EXIT_DIRTY_SAVE_ALL" sequence="<Ctrl+X>" description="Exit with save-all dialog"');
ACTIVE_KEYMAP_PROFILE('name="NANO"');
END_MACRO;
