$MACRO MR_KEYMAP FROM EDIT;
KEYMAP_RESET();
KEYMAP_VERSION('1778962202');
KEYMAP_PROFILE('name="EMACS" description="Emacs core"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_UP" sequence="<Ctrl+P>" description="Cursor up"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_DOWN" sequence="<Ctrl+N>" description="Cursor down"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_LEFT" sequence="<Ctrl+B>" description="Cursor left"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_RIGHT" sequence="<Ctrl+F>" description="Cursor right"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_WORD_LEFT" sequence="<Alt+B>" description="Word left"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_WORD_RIGHT" sequence="<Alt+F>" description="Word right"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MR_BLOCK_MARK_ALL" sequence="<Ctrl+A>" description="Mark all as line block"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_END_OF_LINE" sequence="<Ctrl+E>" description="End of line"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_VIEW_PAGE_UP" sequence="<Alt+V>" description="Page up"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_VIEW_PAGE_DOWN" sequence="<Ctrl+V>" description="Page down"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_TOP_OF_FILE" sequence="<Alt+Home>" description="Beginning of buffer"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_CURSOR_BOTTOM_OF_FILE" sequence="<Alt+End>" description="End of buffer"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_SEARCH_FORWARD" sequence="<Ctrl+S>" description="Incremental search forward"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_SEARCH_REPLACE" sequence="<Alt+%>" description="Query replace"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_DELETE_TO_EOL" sequence="<Ctrl+K>" description="Kill to end of line"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_DELETE_FORWARD_CHAR_OR_BLOCK" sequence="<Ctrl+D>" description="Delete character"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_DELETE_FORWARD_WORD" sequence="<Alt+D>" description="Delete word forward"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_DELETE_BACKWARD_WORD" sequence="<Alt+Backspace>" description="Delete word backward"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_BLOCK_CLEAR" sequence="<Ctrl+G>" description="Cancel mark"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_BLOCK_PASTE_FROM_CLIPBOARD" sequence="<Ctrl+Y>" description="Yank from clipboard"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_BLOCK_COPY_TO_CLIPBOARD" sequence="<Alt+W>" description="Copy marked region to clipboard"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_UNDO" sequence="<Ctrl+X> <Ctrl+U>" description="Undo"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_VIEW_CENTER_LINE" sequence="<Ctrl+L>" description="Recenter line"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MRMAC_FILE_SAVE" sequence="<Ctrl+X> <Ctrl+S>" description="Save file"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MR_BUILD_CURRENT_FILE" sequence="<F9>" description="Build current file"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MR_MATCH_PARENTHESIS" sequence="<Alt+P>" description="Match parenthesis"');
KEYMAP_BIND('name="EMACS" context=EDIT type=ACTION target="MR_EXIT_DIRTY_SAVE_ALL" sequence="<Ctrl+X> <Ctrl+C>" description="Exit with save-all dialog"');
ACTIVE_KEYMAP_PROFILE('name="EMACS"');
END_MACRO;
