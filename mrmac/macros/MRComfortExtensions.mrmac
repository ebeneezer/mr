$MACRO ComfortDuplicate FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, StartCol, EndCol, OriginalLine, OriginalCol);
DEF_STR(BlockText, LineText);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            OriginalLine := C_LINE;
            OriginalCol := C_COL;
            LineText := GET_LINE;
            EOL;
            CR;
            TEXT(LineText);
            GOTO_LINE(OriginalLine + 1);
            GOTO_COL(OriginalCol);
        ELSE
            StartLine := BLOCK_LINE1;
            EndLine := BLOCK_LINE2;
            StartCol := BLOCK_COL1;
            EndCol := BLOCK_COL2;
            BlockText := BLOCK_TEXT;
            IF BlockState = 1 THEN
                GOTO_LINE(EndLine);
                EOL;
                CR;
                TEXT(BlockText);
                GOTO_LINE(EndLine + 1);
                GOTO_COL(1);
            ELSE
                IF BlockState = 2 THEN
                    GOTO_LINE(StartLine);
                    GOTO_COL(EndCol);
                    COPY_BLOCK;
                    GOTO_LINE(StartLine);
                    GOTO_COL(EndCol);
                ELSE
                    GOTO_LINE(EndLine);
                    GOTO_COL(EndCol);
                    TEXT(BlockText);
                END;
            END;
        END;
    END;
END;
END_MACRO;

$MACRO ComfortSortSelectedLinesUnique FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, CurrentLine);
DEF_STR(PreviousText, CurrentText);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            MARQUEE_ERROR('Mark multiple lines first.');
        ELSE
            IF BlockState = 2 THEN
                MARQUEE_ERROR('Use the built-in sort for column blocks.');
            ELSE
                StartLine := BLOCK_LINE1;
                EndLine := BLOCK_LINE2;
                IF StartLine >= EndLine THEN
                    MARQUEE_ERROR('Mark multiple lines first.');
                ELSE
                    RUN_MACRO('ComfortSortSelectedLines');
                    CurrentLine := StartLine + 1;
                    WHILE CurrentLine <= EndLine DO
                        GOTO_LINE(CurrentLine - 1);
                        PreviousText := GET_LINE;
                        DOWN;
                        CurrentText := GET_LINE;
                        IF CurrentText = PreviousText THEN
                            DEL_LINE;
                            EndLine := EndLine - 1;
                        ELSE
                            CurrentLine := CurrentLine + 1;
                        END;
                    END;
                    GOTO_LINE(StartLine);
                    GOTO_COL(1);
                END;
            END;
        END;
    END;
END;
END_MACRO;

$MACRO ComfortToggleLineComment FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, CurrentLine, OriginalLine, OriginalCol, Index, FirstTextCol, SawText, AllCommented, Done, RemoveLen);
DEF_STR(LineText, FirstChar, Prefix, NextChar, NewText);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        OriginalLine := C_LINE;
        OriginalCol := C_COL;
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            StartLine := C_LINE;
            EndLine := C_LINE;
        ELSE
            StartLine := BLOCK_LINE1;
            EndLine := BLOCK_LINE2;
        END;

        SawText := 0;
        AllCommented := 1;
        CurrentLine := StartLine;
        WHILE CurrentLine <= EndLine DO
            GOTO_LINE(CurrentLine);
            LineText := GET_LINE;
            Index := 1;
            Done := 0;
            WHILE (Done = 0) AND (Index <= LENGTH(LineText)) DO
                FirstChar := COPY(LineText, Index, 1);
                IF (FirstChar = ' ') OR (FirstChar = UTF8(9)) THEN
                    Index := Index + 1;
                ELSE
                    Done := 1;
                END;
            END;
            IF Index <= LENGTH(LineText) THEN
                SawText := 1;
                Prefix := COPY(LineText, Index, 2);
                IF Prefix <> '//' THEN
                    AllCommented := 0;
                END;
            END;
            CurrentLine := CurrentLine + 1;
        END;
        IF SawText = 0 THEN
            AllCommented := 0;
        END;

        CurrentLine := StartLine;
        WHILE CurrentLine <= EndLine DO
            GOTO_LINE(CurrentLine);
            LineText := GET_LINE;
            Index := 1;
            Done := 0;
            WHILE (Done = 0) AND (Index <= LENGTH(LineText)) DO
                FirstChar := COPY(LineText, Index, 1);
                IF (FirstChar = ' ') OR (FirstChar = UTF8(9)) THEN
                    Index := Index + 1;
                ELSE
                    Done := 1;
                END;
            END;
            IF Index <= LENGTH(LineText) THEN
                IF AllCommented = 1 THEN
                    RemoveLen := 2;
                    NextChar := COPY(LineText, Index + 2, 1);
                    IF NextChar = ' ' THEN
                        RemoveLen := 3;
                    END;
                    NewText := COPY(LineText, 1, Index - 1) + COPY(LineText, Index + RemoveLen, LENGTH(LineText));
                ELSE
                    NewText := COPY(LineText, 1, Index - 1) + '// ' + COPY(LineText, Index, LENGTH(LineText));
                END;
                PUT_LINE(NewText);
            END;
            CurrentLine := CurrentLine + 1;
        END;

        GOTO_LINE(OriginalLine);
        GOTO_COL(OriginalCol);
    END;
END;
END_MACRO;

$MACRO ComfortAlignAssignments FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, CurrentLine, EqualPos, MaxLeft, LeftLen, PadLen, TrimDone, Index);
DEF_STR(LineText, LeftText, RightText, LastChar, FirstChar, Padding, NewText);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            MARQUEE_ERROR('Mark assignment lines first.');
        ELSE
            IF BlockState = 2 THEN
                MARQUEE_ERROR('Column blocks are not supported.');
            ELSE
                StartLine := BLOCK_LINE1;
                EndLine := BLOCK_LINE2;
                MaxLeft := 0;
                CurrentLine := StartLine;
                WHILE CurrentLine <= EndLine DO
                    GOTO_LINE(CurrentLine);
                    LineText := GET_LINE;
                    EqualPos := POS('=', LineText);
                    IF EqualPos > 0 THEN
                        LeftText := COPY(LineText, 1, EqualPos - 1);
                        TrimDone := 0;
                        WHILE (TrimDone = 0) AND (LENGTH(LeftText) > 0) DO
                            LastChar := COPY(LeftText, LENGTH(LeftText), 1);
                            IF (LastChar = ' ') OR (LastChar = UTF8(9)) THEN
                                LeftText := COPY(LeftText, 1, LENGTH(LeftText) - 1);
                            ELSE
                                TrimDone := 1;
                            END;
                        END;
                        LeftLen := LENGTH(LeftText);
                        IF LeftLen > MaxLeft THEN
                            MaxLeft := LeftLen;
                        END;
                    END;
                    CurrentLine := CurrentLine + 1;
                END;

                CurrentLine := StartLine;
                WHILE CurrentLine <= EndLine DO
                    GOTO_LINE(CurrentLine);
                    LineText := GET_LINE;
                    EqualPos := POS('=', LineText);
                    IF EqualPos > 0 THEN
                        LeftText := COPY(LineText, 1, EqualPos - 1);
                        RightText := COPY(LineText, EqualPos + 1, LENGTH(LineText));

                        TrimDone := 0;
                        WHILE (TrimDone = 0) AND (LENGTH(LeftText) > 0) DO
                            LastChar := COPY(LeftText, LENGTH(LeftText), 1);
                            IF (LastChar = ' ') OR (LastChar = UTF8(9)) THEN
                                LeftText := COPY(LeftText, 1, LENGTH(LeftText) - 1);
                            ELSE
                                TrimDone := 1;
                            END;
                        END;

                        TrimDone := 0;
                        WHILE (TrimDone = 0) AND (LENGTH(RightText) > 0) DO
                            FirstChar := COPY(RightText, 1, 1);
                            IF (FirstChar = ' ') OR (FirstChar = UTF8(9)) THEN
                                RightText := COPY(RightText, 2, LENGTH(RightText) - 1);
                            ELSE
                                TrimDone := 1;
                            END;
                        END;

                        Padding := '';
                        PadLen := MaxLeft - LENGTH(LeftText);
                        Index := 0;
                        WHILE Index < PadLen DO
                            Padding := Padding + ' ';
                            Index := Index + 1;
                        END;
                        NewText := LeftText + Padding + ' = ' + RightText;
                        PUT_LINE(NewText);
                    END;
                    CurrentLine := CurrentLine + 1;
                END;

                GOTO_LINE(StartLine);
                GOTO_COL(1);
            END;
        END;
    END;
END;
END_MACRO;

$MACRO ComfortSmartHome FROM EDIT;
DEF_INT(Index, FirstTextCol, Done);
DEF_STR(LineText, FirstChar);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    LineText := GET_LINE;
    Index := 1;
    Done := 0;
    WHILE (Done = 0) AND (Index <= LENGTH(LineText)) DO
        FirstChar := COPY(LineText, Index, 1);
        IF (FirstChar = ' ') OR (FirstChar = UTF8(9)) THEN
            Index := Index + 1;
        ELSE
            Done := 1;
        END;
    END;
    IF Index > LENGTH(LineText) THEN
        FirstTextCol := 1;
    ELSE
        FirstTextCol := Index;
    END;
    IF C_COL = FirstTextCol THEN
        GOTO_COL(1);
    ELSE
        GOTO_COL(FirstTextCol);
    END;
END;
END_MACRO;

$MACRO ComfortSurroundParentheses FROM EDIT;
DEF_INT(BlockState, StartLine, StartCol);
DEF_STR(BlockText);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            MARQUEE_ERROR('Mark text first.');
        ELSE
            IF BlockState = 2 THEN
                MARQUEE_ERROR('Column blocks are not supported.');
            ELSE
                StartLine := BLOCK_LINE1;
                StartCol := BLOCK_COL1;
                BlockText := BLOCK_TEXT;
                DELETE_BLOCK;
                TEXT('(' + BlockText + ')');
                GOTO_LINE(StartLine);
                GOTO_COL(StartCol + 1);
            END;
        END;
    END;
END;
END_MACRO;

