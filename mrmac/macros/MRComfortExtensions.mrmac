$MACRO ComfortMoveUp FROM EDIT;
DEF_INT(BlockState, StartLine, StartCol, OriginalLine, OriginalCol);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            OriginalLine := C_LINE;
            OriginalCol := C_COL;
            IF OriginalLine > 1 THEN
                BLOCK_BEGIN;
                BLOCK_END;
                GOTO_LINE(OriginalLine - 1);
                GOTO_COL(1);
                MOVE_BLOCK;
                GOTO_LINE(OriginalLine - 1);
                GOTO_COL(OriginalCol);
            END;
        ELSE
            StartLine := BLOCK_LINE1;
            StartCol := BLOCK_COL1;
            IF StartLine > 1 THEN
                GOTO_LINE(StartLine - 1);
                IF BlockState = 1 THEN
                    GOTO_COL(1);
                ELSE
                    GOTO_COL(StartCol);
                END;
                MOVE_BLOCK;
                GOTO_LINE(StartLine - 1);
                IF BlockState = 1 THEN
                    GOTO_COL(1);
                ELSE
                    GOTO_COL(StartCol);
                END;
            END;
        END;
    END;
END;
END_MACRO;

$MACRO ComfortMoveDown FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, StartCol, OriginalLine, OriginalCol);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            OriginalLine := C_LINE;
            OriginalCol := C_COL;
            DOWN;
            IF C_LINE <> OriginalLine THEN
                BLOCK_BEGIN;
                BLOCK_END;
                GOTO_LINE(OriginalLine);
                GOTO_COL(1);
                MOVE_BLOCK;
                GOTO_LINE(OriginalLine + 1);
                GOTO_COL(OriginalCol);
            END;
        ELSE
            StartLine := BLOCK_LINE1;
            EndLine := BLOCK_LINE2;
            StartCol := BLOCK_COL1;
            IF BlockState = 1 THEN
                GOTO_LINE(EndLine + 1);
                IF C_LINE <> EndLine THEN
                    BLOCK_BEGIN;
                    BLOCK_END;
                    GOTO_LINE(StartLine);
                    GOTO_COL(1);
                    MOVE_BLOCK;
                    GOTO_LINE(StartLine + 1);
                    GOTO_COL(1);
                END;
            ELSE
                IF BlockState = 2 THEN
                    GOTO_LINE(EndLine + 1);
                    IF C_LINE <> EndLine THEN
                        GOTO_LINE(StartLine + 1);
                        GOTO_COL(StartCol);
                        MOVE_BLOCK;
                        GOTO_LINE(StartLine + 1);
                        GOTO_COL(StartCol);
                    END;
                ELSE
                    GOTO_LINE(EndLine + 1);
                    IF C_LINE <> EndLine THEN
                        GOTO_COL(StartCol);
                        MOVE_BLOCK;
                        GOTO_LINE(StartLine + 1);
                        GOTO_COL(StartCol);
                    END;
                END;
            END;
        END;
END;
END;
END_MACRO;

$MACRO ComfortDeleteLine FROM EDIT;
DEF_INT(BlockState, OriginalLine);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            OriginalLine := C_LINE;
            DEL_LINE;
            GOTO_LINE(OriginalLine);
        ELSE
            DELETE_BLOCK;
        END;
    END;
END;
END_MACRO;

$MACRO ComfortJoinLines FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, JoinLine, Remaining, TrimDone, OriginalLine, OriginalCol);
DEF_STR(LineText, NextLine, JoinedText, LastChar, FirstChar);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            OriginalLine := C_LINE;
            OriginalCol := C_COL;
            JoinLine := OriginalLine;
            Remaining := 1;
        ELSE
            JoinLine := BLOCK_LINE1;
            Remaining := BLOCK_LINE2 - BLOCK_LINE1;
        END;

        WHILE Remaining > 0 DO
            GOTO_LINE(JoinLine);
            LineText := GET_LINE;
            DOWN;
            IF C_LINE = JoinLine THEN
                Remaining := 0;
            ELSE
                NextLine := GET_LINE;

                TrimDone := 0;
                WHILE (TrimDone = 0) AND (LENGTH(LineText) > 0) DO
                    LastChar := COPY(LineText, LENGTH(LineText), 1);
                    IF (LastChar = ' ') OR (LastChar = UTF8(9)) THEN
                        LineText := COPY(LineText, 1, LENGTH(LineText) - 1);
                    ELSE
                        TrimDone := 1;
                    END;
                END;

                TrimDone := 0;
                WHILE (TrimDone = 0) AND (LENGTH(NextLine) > 0) DO
                    FirstChar := COPY(NextLine, 1, 1);
                    IF (FirstChar = ' ') OR (FirstChar = UTF8(9)) THEN
                        NextLine := COPY(NextLine, 2, LENGTH(NextLine) - 1);
                    ELSE
                        TrimDone := 1;
                    END;
                END;

                IF (LENGTH(LineText) > 0) AND (LENGTH(NextLine) > 0) THEN
                    JoinedText := LineText + ' ' + NextLine;
                ELSE
                    JoinedText := LineText + NextLine;
                END;

                GOTO_LINE(JoinLine);
                PUT_LINE(JoinedText);
                GOTO_LINE(JoinLine + 1);
                DEL_LINE;
                Remaining := Remaining - 1;
            END;
        END;

        IF BlockState = 0 THEN
            GOTO_LINE(OriginalLine);
            GOTO_COL(OriginalCol);
        ELSE
            GOTO_LINE(JoinLine);
            GOTO_COL(1);
        END;
    END;
END;
END_MACRO;

$MACRO ComfortTrimTrailingWhitespace FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, CurrentLine, TrimDone, OriginalLine, OriginalCol);
DEF_STR(LineText, LastChar);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            StartLine := C_LINE;
            EndLine := C_LINE;
            OriginalLine := C_LINE;
            OriginalCol := C_COL;
        ELSE
            StartLine := BLOCK_LINE1;
            EndLine := BLOCK_LINE2;
        END;

        CurrentLine := StartLine;
        WHILE CurrentLine <= EndLine DO
            GOTO_LINE(CurrentLine);
            LineText := GET_LINE;
            TrimDone := 0;
            WHILE (TrimDone = 0) AND (LENGTH(LineText) > 0) DO
                LastChar := COPY(LineText, LENGTH(LineText), 1);
                IF (LastChar = ' ') OR (LastChar = UTF8(9)) THEN
                    LineText := COPY(LineText, 1, LENGTH(LineText) - 1);
                ELSE
                    TrimDone := 1;
                END;
            END;
            PUT_LINE(LineText);
            CurrentLine := CurrentLine + 1;
        END;

        IF BlockState = 0 THEN
            GOTO_LINE(OriginalLine);
            GOTO_COL(OriginalCol);
        ELSE
            GOTO_LINE(StartLine);
            GOTO_COL(1);
        END;
    END;
END;
END_MACRO;

$MACRO ComfortTrimTrailingBlankLines FROM EDIT;
DEF_INT(Done, TrimDone, OriginalLine, OriginalCol);
DEF_STR(LineText, LastChar);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        OriginalLine := C_LINE;
        OriginalCol := C_COL;
        Done := 0;

        WHILE Done = 0 DO
            EOF;
            LineText := GET_LINE;
            TrimDone := 0;
            WHILE (TrimDone = 0) AND (LENGTH(LineText) > 0) DO
                LastChar := COPY(LineText, LENGTH(LineText), 1);
                IF (LastChar = ' ') OR (LastChar = UTF8(9)) THEN
                    LineText := COPY(LineText, 1, LENGTH(LineText) - 1);
                ELSE
                    TrimDone := 1;
                END;
            END;

            IF (LineText = '') AND (C_LINE > 1) THEN
                DEL_LINE;
            ELSE
                Done := 1;
            END;
        END;

        GOTO_LINE(OriginalLine);
        GOTO_COL(OriginalCol);
    END;
END;
END_MACRO;

$MACRO ComfortSortSelectedLines FROM EDIT;
DEF_INT(BlockState, StartLine, EndLine, CurrentLine, Swapped, LeftLen, RightLen, CompareIndex, LeftCode, RightCode, CompareDone, ShouldSwap);
DEF_STR(LeftText, RightText, LeftChar, RightChar);

IF WINDOW_COUNT = 0 THEN
    MARQUEE_ERROR('Open a text window first.');
ELSE
    IF READ_ONLY THEN
        MARQUEE_ERROR('Window is read-only.');
    ELSE
        BlockState := BLOCK_STAT;
        IF BlockState = 0 THEN
            MARQUEE_ERROR('Mark multiple lines first.');
        ELSE
            IF BlockState = 2 THEN
                MARQUEE_ERROR('Use the built-in sort for column blocks.');
            ELSE
                StartLine := BLOCK_LINE1;
                EndLine := BLOCK_LINE2;
                IF StartLine >= EndLine THEN
                    MARQUEE_ERROR('Mark multiple lines first.');
                ELSE
                    Swapped := 1;
                    WHILE Swapped = 1 DO
                        Swapped := 0;
                        CurrentLine := StartLine;
                        WHILE CurrentLine < EndLine DO
                            GOTO_LINE(CurrentLine);
                            LeftText := GET_LINE;
                            DOWN;
                            RightText := GET_LINE;

                            LeftLen := LENGTH(LeftText);
                            RightLen := LENGTH(RightText);
                            CompareIndex := 1;
                            CompareDone := 0;
                            ShouldSwap := 0;

                            WHILE (CompareDone = 0) AND (CompareIndex <= LeftLen) AND (CompareIndex <= RightLen) DO
                                LeftChar := COPY(LeftText, CompareIndex, 1);
                                RightChar := COPY(RightText, CompareIndex, 1);
                                LeftCode := ASCII(LeftChar);
                                RightCode := ASCII(RightChar);
                                IF LeftCode > RightCode THEN
                                    ShouldSwap := 1;
                                    CompareDone := 1;
                                ELSE
                                    IF LeftCode < RightCode THEN
                                        CompareDone := 1;
                                    ELSE
                                        CompareIndex := CompareIndex + 1;
                                    END;
                                END;
                            END;

                            IF (CompareDone = 0) AND (LeftLen > RightLen) THEN
                                ShouldSwap := 1;
                            END;

                            IF ShouldSwap = 1 THEN
                                PUT_LINE(LeftText);
                                GOTO_LINE(CurrentLine);
                                PUT_LINE(RightText);
                                Swapped := 1;
                            END;
                            CurrentLine := CurrentLine + 1;
                        END;
                    END;
                    GOTO_LINE(StartLine);
                    GOTO_COL(1);
                END;
            END;
        END;
    END;
END;
END_MACRO;
