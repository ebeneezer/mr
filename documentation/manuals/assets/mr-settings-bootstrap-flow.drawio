<mxfile host="Electron" modified="2026-07-17T00:00:00.000Z" agent="draw.io" version="30.0.4" type="device">
  <diagram id="settings-bootstrap-flow" name="Settings bootstrap flow">
    <mxGraphModel dx="1200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SETTINGS BOOTSTRAP: FROM PERSISTED SOURCE TO EDITOR UI" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#27313A;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1000" height="28" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Each numbered phase is the reference point for the following technical explanation." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontColor=#53616A;" vertex="1" parent="1"><mxGeometry x="50" y="62" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="rule" value="" style="line;strokeWidth=1;strokeColor=#AEB8BE;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="1100" height="1" as="geometry"/></mxCell>
        <mxCell id="inputLabel" value="PERSISTED INPUT" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontStyle=1;fontColor=#53616A;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="330" height="20" as="geometry"/></mxCell>
        <mxCell id="bootstrapLabel" value="BOOTSTRAP: STAGING AND CANONICALIZATION" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontStyle=1;fontColor=#53616A;" vertex="1" parent="1"><mxGeometry x="200" y="345" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="vmLabel" value="FINAL VM APPLY" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontStyle=1;fontColor=#53616A;" vertex="1" parent="1"><mxGeometry x="200" y="1000" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="uiLabel" value="APPLICATION AND UI PROJECTION" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontStyle=1;fontColor=#53616A;" vertex="1" parent="1"><mxGeometry x="200" y="1470" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="step1" value="1" style="ellipse;html=0;fillColor=#27313A;strokeColor=#27313A;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="165" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box1" value="Ensure a settings source exists&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;Missing file: create current defaults.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F7F8F8;strokeColor=#27313A;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=17;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="570" height="86" as="geometry"/></mxCell>
        <mxCell id="step2" value="2" style="ellipse;html=0;fillColor=#27313A;strokeColor=#27313A;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="270" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box2" value="Read the persisted source&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;An unreadable source becomes empty normalization input.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F7F8F8;strokeColor=#27313A;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=17;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="255" width="570" height="86" as="geometry"/></mxCell>
        <mxCell id="step3" value="3" style="ellipse;html=0;fillColor=#9B651D;strokeColor=#9B651D;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="390" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box3" value="Parse, version-gate, and stage a complete snapshot&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;Reject future Build Epochs; retain known values; discard unknown or obsolete tokens; supply defaults.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F3E8D1;strokeColor=#9B651D;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="370" width="570" height="112" as="geometry"/></mxCell>
        <mxCell id="step4" value="4" style="ellipse;html=0;fillColor=#9B651D;strokeColor=#9B651D;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box4" value="Derive the canonical current-version MRMAC source&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;Rewrite only when normalisation changed the persisted input.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F3E8D1;strokeColor=#9B651D;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="505" width="570" height="100" as="geometry"/></mxCell>
        <mxCell id="workspace" value="WORKSPACE&#xa;Protected persistence extension. It is not absorbed into the canonical core settings model." style="rounded=0;html=0;fillColor=#F7F8F8;strokeColor=#AEB8BE;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontColor=#27313A;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="495" width="310" height="82" as="geometry"/></mxCell>
        <mxCell id="step5" value="5" style="ellipse;html=0;fillColor=#9B651D;strokeColor=#9B651D;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box5" value="Reset the runtime settings model to current defaults&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;This is preload reset, not the final authoritative apply.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F3E8D1;strokeColor=#9B651D;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="635" width="570" height="92" as="geometry"/></mxCell>
        <mxCell id="keymap" value="KEYMAP&#xa;Tolerated staging exception for canonical serialization. The VM still establishes final keymap authority." style="rounded=0;html=0;fillColor=#F7F8F8;strokeColor=#AEB8BE;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontColor=#27313A;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="625" width="310" height="92" as="geometry"/></mxCell>
        <mxCell id="step6" value="6" style="ellipse;html=0;fillColor=#4C7582;strokeColor=#4C7582;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="825" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box6" value="Compile the canonical source&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;The canonical compiler produces bytecode; compile failure stops startup application.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#E8F0F2;strokeColor=#4C7582;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="810" width="570" height="94" as="geometry"/></mxCell>
        <mxCell id="step7" value="7" style="ellipse;html=0;fillColor=#4C7582;strokeColor=#4C7582;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="1055" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box7" value="Execute the compiled source in VM startup-settings mode&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;MRSETUP applies only canonical source. Runtime errors stop the startup apply.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#E8F0F2;strokeColor=#4C7582;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="1035" width="570" height="102" as="geometry"/></mxCell>
        <mxCell id="step8" value="8" style="ellipse;html=0;fillColor=#2F7770;strokeColor=#2F7770;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="1175" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box8" value="Flush the startup keymap batch; clear dirty state&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;Only after successful VM application is the central runtime model authoritative.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#DCEDEB;strokeColor=#2F7770;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="1155" width="570" height="104" as="geometry"/></mxCell>
        <mxCell id="step9" value="9" style="ellipse;html=0;fillColor=#2F7770;strokeColor=#2F7770;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="1515" width="54" height="54" as="geometry"/></mxCell>
        <mxCell id="box9" value="Refresh the UI settings snapshot and apply display layout&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;The editor UI consumes configuration from the authoritative runtime model.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#DCEDEB;strokeColor=#2F7770;strokeWidth=1.2;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=16;fontStyle=1;fontColor=#27313A;spacingLeft=18;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="200" y="1495" width="570" height="100" as="geometry"/></mxCell>
        <mxCell id="editorUi" value="EDITOR UI&#xa;&lt;font style=&quot;font-size:12px;color:#53616A;&quot;&gt;TVision projection of the configured application state&lt;/font&gt;" style="rounded=0;html=1;fillColor=#F7F8F8;strokeColor=#27313A;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=18;fontStyle=1;fontColor=#27313A;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="1650" width="570" height="88" as="geometry"/></mxCell>
        <mxCell id="authority" value="AUTHORITY CHANGES HERE&#xa;The bootstrap owns accepted source. The VM performs final apply. The runtime model owns all running settings. UI is a consumer, never a settings store." style="rounded=0;html=0;fillColor=#F7F8F8;strokeColor=#AEB8BE;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontColor=#27313A;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="810" y="1150" width="310" height="112" as="geometry"/></mxCell>
        <mxCell id="note" value="The normal save path is deliberately absent: persistence is separate from bootstrap application." style="rounded=0;html=0;fillColor=#F7F8F8;strokeColor=#AEB8BE;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Latin Modern Sans;fontSize=12;fontColor=#27313A;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="200" y="1780" width="570" height="38" as="geometry"/></mxCell>
