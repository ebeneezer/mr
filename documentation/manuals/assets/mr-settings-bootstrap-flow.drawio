        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box6" target="box7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box7" target="box8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box8" target="box9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box9" target="editorUi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="workspaceEdge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#7B8790;strokeWidth=1;" edge="1" parent="1" source="box4" target="workspace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="keymapEdge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#7B8790;strokeWidth=1;" edge="1" parent="1" source="box5" target="keymap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="authorityEdge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#7B8790;strokeWidth=1;" edge="1" parent="1" source="box8" target="authority"><mxGeometry relative="1" as="geometry"/></mxCell>
