        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box2" target="box3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box3" target="box4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=blockThin;endFill=1;strokeColor=#3F4B54;strokeWidth=1.5;" edge="1" parent="1" source="box4" target="box5"><mxGeometry relative="1" as="geometry"/></mxCell>
